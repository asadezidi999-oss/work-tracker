// ═══════════════════════════════════════════════════
// SM-2 SPACED REPETITION ALGORITHM
// ═══════════════════════════════════════════════════
const SM2 = {
  calcEF(oldEF, quality) {
    const n = oldEF + (0.1 - (5 - quality) * (0.08 + (5 - quality) * 0.02));
    return Math.max(1.3, n);
  },
  calcInterval(rep, ef, prev) {
    if (rep === 0) return 1;
    if (rep === 1) return 6;
    return Math.round(prev * ef);
  },
  review(wordId, quality) {
    const today = todayStr();
    let card = state.sm2Data[wordId];
    if (!card) card = { ef: 2.5, interval: 0, repetitions: 0, nextReview: today, history: [] };
    card.history.push({ date: today, quality, interval: card.interval });
    if (quality >= 3) {
      card.repetitions++;
      card.interval = this.calcInterval(card.repetitions - 1, card.ef, card.interval);
      card.ef = this.calcEF(card.ef, quality);
    } else {
      card.repetitions = 0;
      card.interval = 1;
    }
    const next = new Date();
    next.setDate(next.getDate() + card.interval);
    card.nextReview = next.toISOString().split('T')[0];
    state.sm2Data[wordId] = card;
    state.lastStudyDate = today;
    saveState();
  },
  getDue() {
    const today = todayStr();
    return VOCAB.filter(w => {
      const c = state.sm2Data[w.id];
      return !c || c.nextReview <= today;
    });
  },
  getDueCount() { return this.getDue().length; },
  getLearningCount() { return Object.keys(state.sm2Data).length; },
  getAvgEF() {
    const vals = Object.values(state.sm2Data);
    return vals.length ? vals.reduce((s, c) => s + c.ef, 0) / vals.length : 2.5;
  },
  getMastered() {
    return Object.entries(state.sm2Data).filter(([_, c]) => c.repetitions >= 3 && c.ef >= 2.5).length;
  },
  getStreak() {
    const today = todayStr();
    const dates = Object.values(state.sm2Data).flatMap(c => c.history.map(h => h.date));
    const unique = [...new Set(dates)].sort().reverse();
    let streak = 0;
    const check = new Date();
    for (const d of unique) {
      const expected = new Date(check);
      expected.setDate(expected.getDate() - streak);
      if (d === expected.toISOString().split('T')[0]) streak++;
      else break;
    }
    return streak;
  }
};

// ═══════════════════════════════════════════════════
// STATE
// ═══════════════════════════════════════════════════
let state = {
  xp:0, streak:0, lastStudyDate:'', wordsLearned:0, level:1,
  learnedWords:{}, favoriteWords:[], quizzesCompleted:0,
  perfectQuizzes:0, lessonsCompleted:0, completedLessons:[],
      dailyWordsToday:0, dailyDate:'', quizHistory:[],
      totalCorrect:0, totalAnswers:0, speechSpeed:0.7,
      name:'المتعلم', onboardingDone:false,
      notifications:false,
      listenedToday:0,
      sm2Data:{},
      pronunciationHistory:[],
};

function saveState(){
  try{localStorage.setItem('almanya_state',JSON.stringify(state))}catch(e){}
}
function loadState(){
  try{
    const s=localStorage.getItem('almanya_state');
    if(s)Object.assign(state,JSON.parse(s));
  }catch(e){}
  checkStreak();
}

function checkStreak(){
  const today=todayStr();
  if(state.lastStudyDate===today) return;
  if(state.lastStudyDate===yesterday()){
    // keep streak, will increment on study
  } else if(state.lastStudyDate && state.lastStudyDate!==today){
    state.streak=0;
    saveState();
  }
  if(state.dailyDate!==today){
    state.dailyWordsToday=0;
    state.dailyDate=today;
    saveState();
  }
}
function todayStr(){return new Date().toISOString().split('T')[0]}
function yesterday(){
  const d=new Date();d.setDate(d.getDate()-1);
  return d.toISOString().split('T')[0];
}
function addXP(amount,x,y){
  state.xp+=amount;
  const newLevel=Math.floor(state.xp/100)+1;
  if(newLevel>state.level){state.level=newLevel;showToast(`🎉 مبروك! وصلت المستوى ${state.level}`);}
  state.lastStudyDate=todayStr();
  saveState();
  // Float XP
  if(x&&y){
    const el=document.createElement('div');
    el.className='xp-float';
    el.textContent=`+${amount} XP`;
    el.style.left=x+'px';el.style.top=y+'px';
    document.body.appendChild(el);
    setTimeout(()=>el.remove(),1200);
  }
  checkAchievements();
}
function markWordLearned(id){
  if(!state.learnedWords[id]){
    state.learnedWords[id]=Date.now();
    state.wordsLearned++;
    state.dailyWordsToday++;
    if(!state.lastStudyDate||state.lastStudyDate===yesterday()){
      state.streak++;
    }
    state.lastStudyDate=todayStr();
    addXP(10);
    checkDailyChallenges();
    saveState();
    updateHomeUI();
  }
}

// ═══════════════════════════════════════════════════
// NAVIGATION
// ═══════════════════════════════════════════════════
let currentScreen='home';
let screenHistory=['home'];
const navScreens=['home','vocabulary','lessons','quiz','profile'];

function showScreen(id, pushHistory=true){
  // Hide quiz result
  const qr=document.getElementById('quiz-result');
  if(qr)qr.style.display='none';

  const prev=document.querySelector('.screen.active');
  if(prev){prev.classList.remove('active');prev.classList.add('exit');}
  setTimeout(()=>{
    document.querySelectorAll('.screen.exit').forEach(s=>s.classList.remove('exit'));
  },300);

  const next=document.getElementById('screen-'+id);
  if(next){
    next.classList.add('active');
    currentScreen=id;
    if(pushHistory)screenHistory.push(id);
  }

  // Update nav
  document.querySelectorAll('.nav-item').forEach(n=>{
    const isActive=n.dataset.screen===id;
    n.classList.toggle('active',isActive);
    n.setAttribute('aria-selected',isActive?'true':'false');
  });

  // Show/hide nav
  const hideNav=['flashcards','lesson-detail','quiz','speaking'];
  document.getElementById('bottom-nav').style.display=hideNav.includes(id)?'none':'flex';

  // Screen init
  if(id==='vocabulary') initVocab();
  if(id==='lessons') initLessons();
  if(id==='flashcards') initFlashcards();
  if(id==='quiz') startQuiz();
  if(id==='profile') updateProfileUI();
  if(id==='listening') initListening();
  if(id==='speaking') initSpeaking();
  if(id==='home') updateHomeUI();
}

function navTo(id){showScreen(id,false);screenHistory=[id]}
function goBack(){
  screenHistory.pop();
  const prev=screenHistory[screenHistory.length-1]||'home';
  showScreen(prev,false);
}

// ═══════════════════════════════════════════════════
// HOME UI
// ═══════════════════════════════════════════════════
function updateHomeUI(){
  const pct=Math.min(100,Math.round(state.dailyWordsToday/10*100));
  el('home-streak').textContent=state.streak;
  el('home-xp').textContent=state.xp;
  el('home-words').textContent=state.wordsLearned;
  el('home-level').textContent=state.level;
  el('daily-goal-text').textContent=`${state.dailyWordsToday} / 10 كلمات`;
  el('daily-progress-fill').style.width=pct+'%';
  el('lesson-progress').style.width=Math.min(100,(state.lessonsCompleted/9*100))+'%';
  const due=SM2.getDueCount();
  const db=el('due-badge');
  if(due>0){db.style.display='flex';el('due-count').textContent=due;}
  else db.style.display='none';
  renderRecentWords();
  renderChallenges();
}
function renderRecentWords(){
  const list=el('recent-words-list');
  const learned=Object.keys(state.learnedWords).map(Number).reverse().slice(0,3);
  if(!learned.length){
    list.innerHTML='<div style="text-align:center;color:var(--text3);padding:20px;font-size:15px">ابدأ التعلم لترى كلماتك هنا ✨</div>';
    return;
  }
  list.innerHTML=learned.map(id=>{
    const w=VOCAB.find(v=>v.id===id);
    if(!w)return '';
    return `<div class="word-card" onclick="openWordModal(${w.id})">
      <div class="word-emoji">${w.emoji}</div>
      <div>
        <div class="word-de">${w.de}</div>
        <div class="word-ar">${w.ar}</div>
      </div>
      <div class="word-card-right" style="display:flex;align-items:center;gap:8px">
        <div class="tag tag-${w.diff}">${diffLabel(w.diff)}</div>
      </div>
    </div>`;
  }).join('');
}

// ═══════════════════════════════════════════════════
// DAILY CHALLENGES
// ═══════════════════════════════════════════════════
const CHALLENGES=[
  {id:'words10',title:'تعلّم 10 كلمات جديدة',emoji:'📚',xp:50,check:s=>s.dailyWordsToday>=10},
  {id:'quiz1',title:'أكمل اختباراً',emoji:'🧠',xp:30,check:s=>s.quizzesCompleted>0&&s.dailyDate===todayStr()},
  {id:'listen3',title:'استمع لـ 3 جمل',emoji:'🎧',xp:20,check:s=>(s.listenedToday||0)>=3},
];
function renderChallenges(){
  const list=el('challenges-list');
  if(!list)return;
  list.innerHTML=CHALLENGES.map(c=>{
    const done=c.check(state);
    return `<div class="card" style="padding:14px 16px;display:flex;align-items:center;gap:14px;opacity:${done?0.6:1}">
      <div style="font-size:28px">${c.emoji}</div>
      <div style="flex:1">
        <div style="font-size:15px;font-weight:600;${done?'text-decoration:line-through;color:var(--text3)':''}">${c.title}</div>
        <div style="font-size:13px;color:var(--yellow);margin-top:2px">+${c.xp} XP</div>
      </div>
      <div style="font-size:20px">${done?'✅':'⭕'}</div>
    </div>`;
  }).join('');
}
function checkDailyChallenges(){}

// ═══════════════════════════════════════════════════
// VOCABULARY
// ═══════════════════════════════════════════════════
let currentCat='all';
function initVocab(){
  renderCatScroll();
  renderVocabList();
}
function renderCatScroll(){
  const s=el('cat-scroll');
  s.innerHTML=CATEGORIES.map(c=>`
    <button class="cat-pill ${currentCat===c.id?'selected':''}" onclick="selectCat('${c.id}')">
      <div class="cat-emoji">${c.emoji}</div>
      <div class="cat-name">${c.name}</div>
    </button>
  `).join('');
}
function selectCat(id){
  currentCat=id;
  renderCatScroll();
  renderVocabList();
}
function renderVocabList(){
  const list=el('vocab-list');
  const words=currentCat==='all'?VOCAB:VOCAB.filter(w=>w.cat===currentCat);
  list.innerHTML='<div style="padding:0 16px;display:flex;flex-direction:column;gap:10px">'+
    words.map(w=>{
      const learned=state.learnedWords[w.id];
      const fav=state.favoriteWords.includes(w.id);
      return `<div class="word-card" onclick="openWordModal(${w.id})">
        <div class="word-emoji">${w.emoji}</div>
        <div style="flex:1">
          <div class="word-de">${w.de}</div>
          <div class="word-ar">${w.ar}</div>
        </div>
        <div style="display:flex;flex-direction:column;align-items:flex-end;gap:6px">
          <div class="tag tag-${w.diff}">${diffLabel(w.diff)}</div>
          ${learned?'<div style="font-size:12px;color:var(--green)">✓ تعلمت</div>':''}
          ${fav?'<div style="font-size:14px">❤️</div>':''}
        </div>
      </div>`;
    }).join('')+'</div>';
}
function diffLabel(d){return d==='easy'?'سهل':d==='medium'?'متوسط':'صعب'}

// ═══════════════════════════════════════════════════
// WORD MODAL
// ═══════════════════════════════════════════════════
let modalWord=null;
function openWordModal(id){
  const w=VOCAB.find(v=>v.id===id);
  if(!w)return;
  modalWord=w;
  el('modal-emoji').textContent=w.emoji;
  el('modal-de').textContent=w.de;
  el('modal-rom').textContent=`[${w.rom}]`;
  el('modal-ar').textContent=w.ar;
  el('modal-example-de').textContent=w.ex_de;
  el('modal-example-ar').textContent=w.ex_ar;
  const cat=CATEGORIES.find(c=>c.id===w.cat);
  el('modal-cat').textContent=cat?`${cat.emoji} ${cat.name}`:'';
  el('modal-diff').innerHTML=`<div class="tag tag-${w.diff}">${diffLabel(w.diff)}</div>`;
  const fav=state.favoriteWords.includes(w.id);
  el('modal-fav-btn').textContent=fav?'💔 إزالة':'❤️ مفضلة';
  el('modal-fav-btn').style.color=fav?'var(--red)':'';
  el('word-modal').classList.add('show');
  markWordLearned(w.id);
}
function closeWordModal(e){
  if(e.target===el('word-modal'))el('word-modal').classList.remove('show');
}
function speakModalWord(){
  if(modalWord)speak(modalWord.de);
}
function toggleFavorite(){
  if(!modalWord)return;
  const idx=state.favoriteWords.indexOf(modalWord.id);
  if(idx>=0){
    state.favoriteWords.splice(idx,1);
    el('modal-fav-btn').textContent='❤️ مفضلة';
    showToast('تمت الإزالة من المفضلة');
  } else {
    state.favoriteWords.push(modalWord.id);
    el('modal-fav-btn').textContent='💔 إزالة';
    showToast('✨ أضيفت إلى المفضلة');
  }
  saveState();
}

// ═══════════════════════════════════════════════════
// FLASHCARDS (SM-2 powered)
// ═══════════════════════════════════════════════════
let fcDeck=[];
let fcIndex=0;
let fcFlipped=false;
function initFlashcards(){
  const due=SM2.getDue();
  fcDeck=due.length?due.sort(()=>Math.random()-0.5):[...VOCAB].sort(()=>Math.random()-0.5).slice(0,10);
  fcIndex=0;fcFlipped=false;
  showFCCard();
  el('fc-actions').style.display='none';
  el('fc-swipe-hint').style.display='block';
}
function showFCCard(){
  const w=fcDeck[fcIndex];
  if(!w){endFlashcards();return;}
  el('fc-word-de').textContent=w.de;
  el('fc-word-rom').textContent=`[${w.rom}]`;
  el('fc-cat-emoji').textContent=w.emoji;
  el('fc-word-ar-back').textContent=w.ar;
  el('fc-example-back').textContent=`"${w.ex_de}"\n"${w.ex_ar}"`;
  el('fc-counter').textContent=`${fcIndex+1}/${fcDeck.length}`;
  el('fc-progress').style.width=`${(fcIndex/fcDeck.length)*100}%`;
  const card=el('flashcard');
  card.classList.remove('flipped');
  fcFlipped=false;
  el('fc-actions').style.display='none';
  el('fc-swipe-hint').style.display='block';
  card.dataset.word=w.de;
  el('flashcard').focus();
}
function flipCard(){
  const card=el('flashcard');
  if(!fcFlipped){
    card.classList.add('flipped');
    fcFlipped=true;
    el('fc-actions').style.display='flex';
    el('fc-swipe-hint').style.display='none';
    markWordLearned(fcDeck[fcIndex].id);
    addXP(5);
  }
}
const QUALITY_MAP={easy:5,medium:3,hard:1};
function rateCard(rating){
  const w=fcDeck[fcIndex];
  if(w)SM2.review(w.id,QUALITY_MAP[rating]||3);
  fcIndex++;
  if(fcIndex>=fcDeck.length){endFlashcards();return;}
  showFCCard();
  const msgs={easy:'ممتاز! 🌟',medium:'جيد 👍',hard:'لا بأس، استمر 💪'};
  showToast(msgs[rating]);
}
function endFlashcards(){
  const due=SM2.getDueCount();
  const msg=due?`🎉 أكملت! ${due} بطاقة للمراجعة`: '🎉 أكملت جميع البطاقات!';
  showToast(msg);
  addXP(20);
  showScreen('home');
}
function speakWord(e){
  e&&e.stopPropagation();
  const w=fcDeck[fcIndex];
  if(w)speak(w.de);
}

// ═══════════════════════════════════════════════════
// LESSONS
// ═══════════════════════════════════════════════════
function initLessons(){
  renderLessons('a1',LESSONS.a1);
  renderLessons('a2',LESSONS.a2);
}
function renderLessons(level,arr){
  const cont=el(`${level}-lessons`);
  if(!cont)return;
  let unlocked=true;
  cont.innerHTML=arr.map((lesson,i)=>{
    const done=state.completedLessons.includes(lesson.id);
    const stars=done?3:0;
    const locked=!unlocked&&!done;
    if(!done&&unlocked)unlocked=false;
    else if(done)unlocked=true;
    return `<div class="lesson-card ${locked?'lesson-locked':''}" onclick="${locked?'':` startLesson('${lesson.id}')`}">
      <div class="lesson-num ${done?'gradient-green':'gradient-accent'}" style="color:#fff">${lesson.emoji}</div>
      <div class="lesson-info">
        <div class="lesson-title">${lesson.title}</div>
        <div class="lesson-sub">${lesson.sub} — ${lesson.level}</div>
        <div class="lesson-stars">
          ${[0,1,2].map(s=>`<span class="lesson-star ${s<stars?'earned':''}">⭐</span>`).join('')}
        </div>
      </div>
      ${locked?'<span style="font-size:20px">🔒</span>':done?'<span style="color:var(--green);font-size:20px">✓</span>':'<span style="color:var(--text3);font-size:20px">›</span>'}
    </div>`;
  }).join('');
}

// ═══════════════════════════════════════════════════
// LESSON DETAIL
// ═══════════════════════════════════════════════════
let currentLesson=null;
let ldStep=0;
let ldWords=[];
function startLesson(id){
  const all=[...LESSONS.a1,...LESSONS.a2];
  currentLesson=all.find(l=>l.id===id);
  if(!currentLesson)return;
  ldStep=0;
  ldWords=currentLesson.words.map(wid=>VOCAB.find(v=>v.id===wid)).filter(Boolean);
  el('ld-title').textContent=currentLesson.title;
  showScreen('lesson-detail');
  renderLessonStep();
}
function renderLessonStep(){
  const total=ldWords.length+2; // intro + words + quiz
  const pct=Math.round((ldStep/total)*100);
  el('ld-progress').style.width=pct+'%';
  el('ld-step-label').textContent=`${ldStep+1} من ${total}`;
  const cont=el('ld-content');
  if(ldStep===0){
    // Intro
    cont.innerHTML=`
      <div style="text-align:center;padding:24px 0">
        <div style="font-size:72px;margin-bottom:16px">${currentLesson.emoji}</div>
        <div style="font-size:26px;font-weight:800;letter-spacing:-0.5px;margin-bottom:8px">${currentLesson.title}</div>
        <div style="font-size:17px;color:var(--text2);direction:ltr;margin-bottom:24px">${currentLesson.sub}</div>
        <div class="card" style="padding:20px;text-align:right">
          <div style="font-size:15px;font-weight:600;margin-bottom:8px">في هذا الدرس ستتعلم:</div>
          ${ldWords.map(w=>`<div style="padding:8px 0;border-bottom:1px solid var(--border);display:flex;align-items:center;gap:10px">
            <span>${w.emoji}</span>
            <span style="direction:ltr;font-weight:700">${w.de}</span>
            <span style="color:var(--text2)"> — ${w.ar}</span>
          </div>`).join('')}
        </div>
      </div>`;
    el('ld-next-btn').textContent='ابدأ الدرس →';
  } else if(ldStep<=ldWords.length){
    const w=ldWords[ldStep-1];
    cont.innerHTML=`
      <div style="text-align:center;padding:16px 0">
        <div style="font-size:64px;margin-bottom:16px">${w.emoji}</div>
        <div style="font-size:38px;font-weight:800;letter-spacing:-1px;direction:ltr;margin-bottom:4px">${w.de}</div>
        <div style="font-size:16px;color:var(--text3);font-style:italic;direction:ltr;margin-bottom:12px">[${w.rom}]</div>
        <div style="font-size:24px;color:var(--text2);margin-bottom:24px">${w.ar}</div>
        <button class="btn btn-secondary" style="margin:0 auto" onclick="speak('${w.de.replace(/'/g,"\\'")}')">🔊 استمع للنطق</button>
      </div>
      <div class="card2" style="padding:16px;margin-top:20px">
        <div style="font-size:12px;color:var(--text2);margin-bottom:8px;text-transform:uppercase;letter-spacing:0.5px">مثال</div>
        <div style="font-size:16px;font-weight:600;direction:ltr;margin-bottom:6px;line-height:1.5">${w.ex_de}</div>
        <div style="font-size:14px;color:var(--text2)">${w.ex_ar}</div>
      </div>`;
    markWordLearned(w.id);
    el('ld-next-btn').textContent=ldStep<ldWords.length?'التالي →':'اختبر نفسك →';
  } else {
    // Mini quiz
    const w=ldWords[Math.floor(Math.random()*ldWords.length)];
    const wrong=VOCAB.filter(v=>v.id!==w.id).sort(()=>Math.random()-0.5).slice(0,3);
    const opts=[w,...wrong].sort(()=>Math.random()-0.5);
    cont.innerHTML=`
      <div style="margin-bottom:24px">
        <div style="font-size:14px;color:var(--text2);margin-bottom:8px">ما معنى هذه الكلمة؟</div>
        <div style="font-size:32px;font-weight:800;direction:ltr;margin-bottom:20px">${w.de}</div>
        <div style="display:flex;flex-direction:column;gap:10px" id="lesson-quiz-opts">
          ${opts.map((o,i)=>`
            <div class="quiz-option" onclick="checkLessonOpt(this,${o.id===w.id})">
              <div class="quiz-letter">${['أ','ب','ج','د'][i]}</div>
              <div>${o.ar}</div>
            </div>`).join('')}
        </div>
      </div>`;
    el('ld-next-btn').textContent='التالي →';
    el('ld-next-btn').disabled=true;
    el('ld-next-btn').style.opacity='0.5';
  }
}
function checkLessonOpt(el,correct){
  document.querySelectorAll('#lesson-quiz-opts .quiz-option').forEach(o=>o.style.pointerEvents='none');
  el.classList.add(correct?'correct':'wrong');
  document.getElementById('ld-next-btn').disabled=false;
  document.getElementById('ld-next-btn').style.opacity='1';
  if(correct){addXP(15);showToast('✅ إجابة صحيحة!');}
  else showToast('❌ إجابة خاطئة');
}
function nextLessonStep(){
  const total=ldWords.length+2;
  ldStep++;
  if(ldStep>=total){
    // Lesson complete
    if(!state.completedLessons.includes(currentLesson.id)){
      state.completedLessons.push(currentLesson.id);
      state.lessonsCompleted++;
    }
    addXP(50);
    saveState();
    showToast('🎉 أكملت الدرس! +50 XP');
    setTimeout(()=>{showScreen('lessons');initLessons();},500);
  } else {
    renderLessonStep();
  }
}

// ═══════════════════════════════════════════════════
// QUIZ
// ═══════════════════════════════════════════════════
let quizQuestions=[];
let quizIndex=0;
let quizCorrect=0;
let quizWrong=0;
let quizXP=0;

const QUIZ_TYPES=['mc','match','fill','listen'];

function startQuiz(){
  const qr=el('quiz-result');
  if(qr){qr.style.display='none';}
  quizQuestions=generateQuiz(10);
  quizIndex=0;quizCorrect=0;quizWrong=0;quizXP=0;
  renderQuizQuestion();
}
function generateQuiz(n){
  const pool=[...VOCAB].sort(()=>Math.random()-0.5).slice(0,n);
  return pool.map((w,i)=>{
    const type=QUIZ_TYPES[i%QUIZ_TYPES.length];
    return {word:w,type};
  });
}
function renderQuizQuestion(){
  const q=quizQuestions[quizIndex];
  if(!q){endQuiz();return;}
  el('quiz-counter').textContent=`${quizIndex+1}/${quizQuestions.length}`;
  el('quiz-progress').style.width=`${((quizIndex+1)/quizQuestions.length)*100}%`;
  const area=el('quiz-area');

  if(q.type==='mc'||q.type==='listen'){
    const w=q.word;
    const isListen=q.type==='listen';
    const wrong=VOCAB.filter(v=>v.id!==w.id).sort(()=>Math.random()-0.5).slice(0,3);
    const opts=[w,...wrong].sort(()=>Math.random()-0.5);
    el('quiz-title').textContent=isListen?'استماع':'اختيار من متعدد';
    area.innerHTML=`
      <div style="text-align:center;margin-bottom:28px">
        ${isListen?`
          <div style="font-size:14px;color:var(--text2);margin-bottom:16px">استمع واختر المعنى الصحيح</div>
          <button class="btn btn-secondary" style="margin:0 auto" onclick="speak('${w.de.replace(/'/g,"\\'")}')">
            🔊 استمع للكلمة
          </button>
        `:`
          <div style="font-size:14px;color:var(--text2);margin-bottom:8px">ما معنى هذه الكلمة؟</div>
          <div style="font-size:36px;font-weight:800;direction:ltr">${w.de}</div>
          <div style="font-size:14px;color:var(--text3);font-style:italic;direction:ltr;margin-top:4px">[${w.rom}]</div>
        `}
      </div>
      <div style="display:flex;flex-direction:column;gap:10px">
        ${opts.map((o,i)=>`
          <div class="quiz-option" onclick="answerQuiz(this,${o.id===w.id})">
            <div class="quiz-letter">${['أ','ب','ج','د'][i]}</div>
            <div>${o.ar}</div>
          </div>`).join('')}
      </div>`;
  } else if(q.type==='match'){
    el('quiz-title').textContent='طابق الكلمة';
    const w=q.word;
    const wrong=VOCAB.filter(v=>v.id!==w.id).sort(()=>Math.random()-0.5).slice(0,3);
    const deWords=[w,...wrong].sort(()=>Math.random()-0.5);
    const arWords=[w,...wrong].sort(()=>Math.random()-0.5);
    area.innerHTML=`
      <div style="font-size:15px;color:var(--text2);margin-bottom:16px;text-align:center">اختر الكلمة الألمانية المقابلة</div>
      <div class="match-grid" id="match-de">
        ${deWords.map(v=>`<div class="match-card" data-id="${v.id}" data-type="de" style="direction:ltr" onclick="selectMatch(this,'de')">${v.de}</div>`).join('')}
      </div>
      <div style="height:16px"></div>
      <div class="match-grid" id="match-ar">
        ${arWords.map(v=>`<div class="match-card" data-id="${v.id}" data-type="ar" onclick="selectMatch(this,'ar')">${v.ar}</div>`).join('')}
      </div>
      <div id="match-msg" style="text-align:center;margin-top:16px;font-size:15px;min-height:24px"></div>
    `;
  } else if(q.type==='fill'){
    el('quiz-title').textContent='أكمل الجملة';
    const w=q.word;
    const sentence=w.ex_de.replace(new RegExp(w.de,'gi'),'___');
    const wrong=VOCAB.filter(v=>v.id!==w.id).sort(()=>Math.random()-0.5).slice(0,3);
    const opts=[w,...wrong].sort(()=>Math.random()-0.5);
    area.innerHTML=`
      <div style="margin-bottom:24px">
        <div style="font-size:14px;color:var(--text2);margin-bottom:12px">أكمل الجملة:</div>
        <div class="card2" style="padding:16px;font-size:18px;font-weight:600;direction:ltr;line-height:1.6">${sentence}</div>
        <div style="font-size:13px;color:var(--text3);margin-top:8px">${w.ex_ar}</div>
      </div>
      <div style="display:flex;flex-direction:column;gap:10px">
        ${opts.map((o,i)=>`
          <div class="quiz-option" style="direction:ltr" onclick="answerQuiz(this,${o.id===w.id})">
            <div class="quiz-letter">${['A','B','C','D'][i]}</div>
            <div style="font-weight:700">${o.de}</div>
          </div>`).join('')}
      </div>`;
  }
}
let matchSelected={de:null,ar:null};
function selectMatch(el,type){
  if(el.classList.contains('matched'))return;
  // Deselect others of same type
  document.querySelectorAll(`.match-card[data-type="${type}"]`).forEach(c=>c.classList.remove('selected'));
  el.classList.add('selected');
  matchSelected[type]=el;
  if(matchSelected.de&&matchSelected.ar){
    const correct=matchSelected.de.dataset.id===matchSelected.ar.dataset.id;
    if(correct){
      matchSelected.de.classList.add('matched');matchSelected.de.classList.remove('selected');
      matchSelected.ar.classList.add('matched');matchSelected.ar.classList.remove('selected');
      matchSelected={de:null,ar:null};
      // Check if all matched
      const total=document.querySelectorAll('.match-card[data-type="de"]').length;
      const done=document.querySelectorAll('.match-card.matched').length/2;
      if(done>=total){
        setTimeout(()=>answerQuiz(null,true),400);
      }
      el('match-msg').textContent='✅ صواب!';el('match-msg').style.color='var(--green)';
    } else {
      quizWrong++;state.totalAnswers++;
      matchSelected.de.classList.add('wrong');matchSelected.ar.classList.add('wrong');
      setTimeout(()=>{
        matchSelected.de.classList.remove('wrong','selected');
        matchSelected.ar.classList.remove('wrong','selected');
        matchSelected={de:null,ar:null};
        el('match-msg').textContent='';
      },600);
      el('match-msg').textContent='❌ خطأ';el('match-msg').style.color='var(--red)';
    }
  }
}
function answerQuiz(optEl,correct){
  if(optEl){
    document.querySelectorAll('.quiz-option').forEach(o=>o.style.pointerEvents='none');
    optEl.classList.add(correct?'correct':'wrong');
    if(!correct){
      document.querySelectorAll('.quiz-option').forEach(o=>{
        if(o!==optEl)o.classList.add('correct');
      });
    }
  }
  if(correct){
    quizCorrect++;quizXP+=10;
    addXP(10);
    if(optEl)showToast('✅ إجابة صحيحة! +10 XP');
  } else {
    quizWrong++;
    if(optEl)showToast('❌ إجابة خاطئة');
  }
  state.totalAnswers++;
  if(correct)state.totalCorrect++;
  saveState();
  setTimeout(()=>{
    quizIndex++;
    renderQuizQuestion();
  },correct?800:1200);
}
function endQuiz(){
  state.quizzesCompleted++;
  if(quizWrong===0&&quizCorrect>0)state.perfectQuizzes++;
  addXP(quizXP+20);
  saveState();
  checkAchievements();
  const pct=Math.round(quizCorrect/(quizCorrect+quizWrong)*100)||0;
  el('result-score').textContent=quizCorrect;
  el('result-wrong').textContent=quizWrong;
  el('result-xp').textContent=quizXP+20;
  el('result-emoji').textContent=pct>=80?'🏆':pct>=60?'😊':'💪';
  el('result-title').textContent=pct>=80?'رائع!':pct>=60?'جيد جداً':'استمر!';
  el('result-sub').textContent=`${pct}% إجابات صحيحة`;
  const qr=el('quiz-result');
  qr.style.display='flex';
  qr.classList.add('bounce-in');
}
function exitQuiz(){showScreen('home')}

// ═══════════════════════════════════════════════════
// LISTENING
// ═══════════════════════════════════════════════════
function initListening(){
  const list=el('listening-list');
  const phrases=VOCAB.filter((_,i)=>i%3===0).slice(0,12);
  list.innerHTML=phrases.map(w=>`
    <div class="player-card">
      <div style="display:flex;align-items:center;justify-content:space-between;width:100%">
        <div>
          <div style="font-size:13px;color:var(--text2);margin-bottom:4px">${w.ar}</div>
          <div class="player-text">${w.de}</div>
          <div style="font-size:13px;color:var(--text3);font-style:italic;direction:ltr">[${w.rom}]</div>
        </div>
        <div style="font-size:36px">${w.emoji}</div>
      </div>
      <div style="display:flex;gap:10px;width:100%;align-items:center">
        <button class="btn btn-primary" style="flex:1;height:44px;font-size:15px" onclick="playListen(this,'${w.de.replace(/'/g,"\\'")}')">🔊 استمع</button>
        <button class="btn btn-secondary" style="flex:1;height:44px;font-size:15px" onclick="playListen(this,'${w.de.replace(/'/g,"\\'")}',0.5)">🐢 بطيء</button>
      </div>
    </div>
  `).join('');
}
function playListen(btn,text,rate){
  speak(text,rate);
  state.listenedToday=(state.listenedToday||0)+1;
  saveState();
  const orig=btn.textContent;
  btn.textContent='▶ جاري التشغيل...';
  setTimeout(()=>btn.textContent=orig,2000);
}

// ═══════════════════════════════════════════════════
// SPEAKING
// ═══════════════════════════════════════════════════
let speakIndex=0;
let isRecording=false;
let recognition=null;
function initSpeaking(){
  speakIndex=0;
  showSpeakPhrase();
}
function showSpeakPhrase(){
  const p=PHRASES_SPEAK[speakIndex%PHRASES_SPEAK.length];
  el('speak-phrase-de').textContent=p.de;
  el('speak-phrase-ar').textContent=p.ar;
  el('speak-result').style.display='none';
  el('speak-circle').classList.remove('recording');
  el('speak-icon').textContent='🎤';
  el('speak-status').textContent='اضغط للتحدث';
  isRecording=false;
}
function nextSpeakPhrase(){speakIndex++;showSpeakPhrase();}
function listenAndSpeak(){speak(PHRASES_SPEAK[speakIndex%PHRASES_SPEAK.length].de);}
function toggleRecording(){
  if(isRecording){stopRecording();}else{startRecording();}
}
function startRecording(){
  isRecording=true;
  el('speak-circle').classList.add('recording');
  el('speak-icon').textContent='⏹';
  el('speak-status').textContent='جاري الاستماع...';

  if('webkitSpeechRecognition' in window||'SpeechRecognition' in window){
    const SR=window.SpeechRecognition||window.webkitSpeechRecognition;
    recognition=new SR();
    recognition.lang='de-DE';
    recognition.continuous=false;
    recognition.interimResults=false;
    recognition.onresult=(e)=>{
      const said=e.results[0][0].transcript;
      const target=PHRASES_SPEAK[speakIndex%PHRASES_SPEAK.length].de;
      scoreSpeech(said,target);
    };
    recognition.onerror=()=>scoreSpeech('',PHRASES_SPEAK[speakIndex%PHRASES_SPEAK.length].de);
    recognition.onend=()=>{if(isRecording)recognition.start();};
    recognition.start();
    setTimeout(()=>{if(isRecording)stopRecording();},5000);
  } else {
    setTimeout(()=>{
      // Simulate for non-supporting browsers
      const score=Math.floor(Math.random()*40)+60;
      showSpeakScore(score);
    },2500);
  }
}
function stopRecording(){
  isRecording=false;
  el('speak-circle').classList.remove('recording');
  el('speak-icon').textContent='🎤';
  el('speak-status').textContent='اضغط للتحدث';
  if(recognition){try{recognition.onend=null;recognition.stop();}catch(e){}}
}
function levenshtein(a,b){
  const m=[];
  for(let i=0;i<=b.length;i++){m[i]=[i];for(let j=1;j<=a.length;j++)m[i][j]=i===0?j:0;}
  for(let i=1;i<=b.length;i++)for(let j=1;j<=a.length;j++)
    m[i][j]=b[i-1]===a[j-1]?m[i-1][j-1]:Math.min(m[i-1][j-1]+1,m[i][j-1]+1,m[i-1][j]+1);
  return m[b.length][a.length];
}
function phonemeSimilarity(said,target){
  const s=said.toLowerCase().trim(),t=target.toLowerCase().trim();
  if(s===t)return 100;
  const dist=levenshtein(s,t);
  const maxLen=Math.max(s.length,t.length);
  return Math.round((1-dist/maxLen)*100);
}
function wordMatchScore(said,target){
  const sw=said.toLowerCase().trim().split(/\s+/);
  const tw=target.toLowerCase().trim().split(/\s+/);
  const matches=sw.filter(w=>tw.includes(w)).length;
  return Math.round((matches/tw.length)*100);
}
function scoreSpeech(said,target){
  stopRecording();
  const s=(said||'').toLowerCase().trim();
  const t=target.toLowerCase().trim();
  let score=0;
  if(s===t)score=100;
  else if(!s)score=0;
  else{
    const phScore=phonemeSimilarity(s,t);
    const wmScore=wordMatchScore(s,t);
    score=Math.round(phScore*0.6+wmScore*0.4);
    score=Math.max(0,Math.min(99,score));
  }
  state.pronunciationHistory=state.pronunciationHistory||[];
  state.pronunciationHistory.push(score);
  saveState();
  showSpeakScore(s,score);
}
function speakFeedback(said,target,score){
  if(score>=95)return ['ممتاز! نطقك مطابق تماماً 🌟','عين الكلمة'];
  if(score>=80)return ['جيد جداً! تقترب من النطق المثالي 👍','حروف قليلة تحتاج تحسين'];
  if(score>=60)return ['لا بأس، استمر في التدريب 💪','حاول نطق المقاطع ببطء'];
  if(score>=40)return ['حاول مرة أخرى، ركز على المخارج 🗣️','استمع للنطق الصحيح أولاً'];
  return ['ابدأ بالاستماع ثم حاول 🔄','اضغط على زر الاستماع'];
}
function highlightDifferences(said,target){
  if(!said)return {said:'',target};
  const s=said.toLowerCase().trim(),t=target.toLowerCase().trim();
  if(s===t)return {said,target};
  let si=0,ti=0;
  let sOut='',tOut='';
  while(si<s.length||ti<t.length){
    if(s[si]===t[ti]){sOut+=s[si]||'';tOut+=t[ti]||'';si++;ti++;}
    else{
      if(s[si]&&(!t[ti]||s[si]!==t[ti])){sOut+=`<span style="color:var(--red);font-weight:700">${s[si]||'?'}</span>`;si++;}
      if(t[ti]&&(!s[si]||t[ti]!==s[si])){tOut+=`<span style="color:var(--green);font-weight:700">${t[ti]||'?'}</span>`;ti++;}
    }
  }
  return {said:sOut,target:tOut};
}
function showSpeakScore(said,score){
  el('speak-result').style.display='block';
  const color=score>=80?'var(--green)':score>=60?'var(--yellow)':score>=40?'var(--orange)':'var(--red)';
  const [feedback,detail]=speakFeedback(said,PHRASES_SPEAK[speakIndex%PHRASES_SPEAK.length].de,score);
  const diff=highlightDifferences(said,PHRASES_SPEAK[speakIndex%PHRASES_SPEAK.length].de);
  el('speak-score').textContent=score+'%';
  el('speak-score').style.color=color;
  el('speak-feedback').innerHTML=`
    <div style="font-size:22px;font-weight:700;margin-bottom:8px">${feedback}</div>
    <div style="font-size:14px;color:var(--text2);margin-bottom:12px">${detail}</div>
    ${said?`<div style="direction:ltr;font-size:15px;padding:12px;background:var(--bg3);border-radius:10px;margin-bottom:8px">
      <div style="font-size:12px;color:var(--text3);margin-bottom:4px">قلت:</div>
      <div>${diff.said}</div>
    </div>`:''}
    <div style="direction:ltr;font-size:15px;padding:12px;background:var(--bg3);border-radius:10px">
      <div style="font-size:12px;color:var(--text3);margin-bottom:4px">الصحيح:</div>
      <div>${diff.target}</div>
    </div>`;
  if(score>=60)addXP(10);
}

// ═══════════════════════════════════════════════════
// SEARCH
// ═══════════════════════════════════════════════════
function doSearch(q){
  const r=el('search-results');
  if(!q){
    r.innerHTML='<div style="text-align:center;color:var(--text3);padding:40px 20px"><div style="font-size:40px;margin-bottom:12px">🔍</div><div>ابحث عن كلمة ألمانية أو عربية</div></div>';
    return;
  }
  const ql=q.toLowerCase();
  const found=VOCAB.filter(w=>w.de.toLowerCase().includes(ql)||w.ar.includes(q)||w.rom.toLowerCase().includes(ql));
  if(!found.length){
    r.innerHTML='<div style="text-align:center;color:var(--text3);padding:40px 20px"><div style="font-size:40px;margin-bottom:12px">😕</div><div>لا توجد نتائج</div></div>';
    return;
  }
  r.innerHTML='<div style="padding:0 16px;display:flex;flex-direction:column;gap:10px">'+
    found.map(w=>`<div class="word-card" onclick="openWordModal(${w.id})">
      <div class="word-emoji">${w.emoji}</div>
      <div><div class="word-de">${w.de}</div><div class="word-ar">${w.ar}</div></div>
      <div class="tag tag-${w.diff}" style="margin-right:auto">${diffLabel(w.diff)}</div>
    </div>`).join('')+'</div>';
}

// ═══════════════════════════════════════════════════
// PROFILE
// ═══════════════════════════════════════════════════
function updateProfileUI(){
  el('profile-name').textContent=state.name;
  el('profile-level').textContent=state.level;
  el('profile-streak').textContent=state.streak;
  el('profile-xp').textContent=state.xp;
  el('level-label').textContent=state.level;
  el('level-ring-text').textContent=state.level;
  el('settings-name').textContent=state.name;

  const xpInLevel=state.xp%100;
  const pct=xpInLevel;
  el('xp-to-next').textContent=100-xpInLevel;
  el('level-progress-fill').style.width=pct+'%';
  el('level-ring').style.setProperty('--pct',pct+'%');

  const acc=state.totalAnswers>0?Math.round(state.totalCorrect/state.totalAnswers*100):0;
  el('stat-words').textContent=state.wordsLearned;
  el('stat-quizzes').textContent=state.quizzesCompleted;
  el('stat-accuracy').textContent=acc+'%';
  el('stat-lessons').textContent=state.lessonsCompleted;
  el('stat-mastered').textContent=SM2.getMastered();
  el('stat-learning').textContent=SM2.getLearningCount();
  el('stat-ef').textContent=SM2.getAvgEF().toFixed(2);
  const pHist=state.pronunciationHistory||[];
  const avgP=pHist.length?Math.round(pHist.reduce((s,v)=>s+v,0)/pHist.length):0;
  el('stat-pronunciation').textContent=avgP+'%';

  renderAchievements();
  renderFavorites();
}
function renderAchievements(){
  const list=el('achievements-list');
  list.innerHTML=ACHIEVEMENTS.map(a=>{
    const unlocked=a.condition(state);
    return `<div class="achievement-card ${unlocked?'':'ach-locked'}">
      <div class="ach-icon" style="background:${unlocked?'var(--yellow2)':'var(--bg3)'}">
        <span>${a.emoji}</span>
      </div>
      <div>
        <div style="font-size:16px;font-weight:700">${a.title}</div>
        <div style="font-size:13px;color:var(--text2);margin-top:2px">${a.desc}</div>
        ${unlocked?'<div style="font-size:12px;color:var(--yellow);margin-top:4px;font-weight:600">✓ محقق</div>':''}
      </div>
    </div>`;
  }).join('');
}
function renderFavorites(){
  const list=el('favorites-list');
  el('fav-count').textContent=state.favoriteWords.length+' كلمة';
  if(!state.favoriteWords.length){
    list.innerHTML='<div style="text-align:center;color:var(--text3);padding:16px;font-size:14px">لا توجد كلمات مفضلة بعد<br>اضغط ❤️ على أي كلمة لحفظها</div>';
    return;
  }
  list.innerHTML=state.favoriteWords.map(id=>{
    const w=VOCAB.find(v=>v.id===id);
    if(!w)return '';
    return `<div class="word-card" onclick="openWordModal(${w.id})">
      <div class="word-emoji">${w.emoji}</div>
      <div><div class="word-de">${w.de}</div><div class="word-ar">${w.ar}</div></div>
      <span style="font-size:18px;margin-right:auto">❤️</span>
    </div>`;
  }).join('');
}
function checkAchievements(){
  ACHIEVEMENTS.forEach(a=>{
    if(a.condition(state)&&!state[`ach_${a.id}`]){
      state[`ach_${a.id}`]=true;
      saveState();
      setTimeout(()=>showToast(`🏆 إنجاز جديد: ${a.title} ${a.emoji}`),500);
    }
  });
}

// ═══════════════════════════════════════════════════
// SETTINGS
// ═══════════════════════════════════════════════════
function setSpeed(rate,btn){
  state.speechSpeed=rate;
  saveState();
  document.querySelectorAll('.speed-btn').forEach(b=>b.classList.remove('active'));
  btn.classList.add('active');
}
function toggleNotif(){
  state.notifications=!state.notifications;
  const t=el('toggle-notif');
  t.classList.toggle('on',state.notifications);
  saveState();
}
function editName(){
  const name=prompt('أدخل اسمك:',state.name);
  if(name&&name.trim()){
    state.name=name.trim();
    saveState();
    el('settings-name').textContent=state.name;
    updateProfileUI();
  }
}
function resetProgress(){
  if(confirm('هل أنت متأكد؟ سيتم حذف جميع بياناتك.')){
    localStorage.removeItem('almanya_state');
    location.reload();
  }
}

// ═══════════════════════════════════════════════════
// SPEECH
// ═══════════════════════════════════════════════════
function speak(text,rate){
  if(!('speechSynthesis' in window))return;
  window.speechSynthesis.cancel();
  const u=new SpeechSynthesisUtterance(text);
  u.lang='de-DE';
  u.rate=rate||state.speechSpeed||0.7;
  u.pitch=1;
  // Try to get a German voice
  const voices=window.speechSynthesis.getVoices();
  const german=voices.find(v=>v.lang.startsWith('de'));
  if(german)u.voice=german;
  window.speechSynthesis.speak(u);
}
// Load voices
if('speechSynthesis' in window){
  window.speechSynthesis.onvoiceschanged=()=>window.speechSynthesis.getVoices();
  window.speechSynthesis.getVoices();
}

// ═══════════════════════════════════════════════════
// HELPERS
// ═══════════════════════════════════════════════════
function el(id){return document.getElementById(id)}
let toastTimer=null;
function showToast(msg){
  const t=el('toast');
  t.textContent=msg;
  t.classList.add('show');
  if(toastTimer)clearTimeout(toastTimer);
  toastTimer=setTimeout(()=>t.classList.remove('show'),2500);
}

// ═══════════════════════════════════════════════════
// ONBOARDING
// ═══════════════════════════════════════════════════
let onboardSlide=0;
function initOnboarding(){
  el('onboard-next').addEventListener('click',()=>{
    onboardSlide++;
    if(onboardSlide>=4){finishOnboarding();return;}
    document.querySelectorAll('.onboard-slide').forEach(s=>s.classList.remove('active'));
    el(`slide-${onboardSlide}`).classList.add('active');
    document.querySelectorAll('.onboard-dot').forEach((d,i)=>{
      d.classList.toggle('active',i===onboardSlide);
    });
    if(onboardSlide===3)el('onboard-next').textContent='ابدأ الآن!';
  });
  el('onboard-skip').addEventListener('click',finishOnboarding);
}
function finishOnboarding(){
  state.onboardingDone=true;
  saveState();
  el('onboarding').classList.add('hidden');
  el('app').style.display='flex';
  setTimeout(()=>{
    updateHomeUI();
    initLessons();
  },200);
  showToast('🎉 مرحباً! ابدأ رحلتك الألمانية');
}

// ═══════════════════════════════════════════════════
// PWA
// ═══════════════════════════════════════════════════
let deferredPrompt=null;
function registerSW(){
  if('serviceWorker' in navigator){
    navigator.serviceWorker.register('sw.js').catch(()=>{});
  }
  window.addEventListener('beforeinstallprompt',e=>{
    e.preventDefault();
    deferredPrompt=e;
    showInstallPrompt();
  });
}
function showInstallPrompt(){
  const existing=document.getElementById('install-prompt');
  if(existing)return;
  const div=document.createElement('div');
  div.id='install-prompt';
  div.style.cssText='position:fixed;bottom:calc(var(--nav-height,83px)+var(--safe-bottom,34px)+16px);left:16px;right:16px;z-index:7000;background:var(--card);border-radius:var(--radius);border:1px solid var(--border2);padding:16px 20px;display:flex;align-items:center;gap:14px;box-shadow:0 8px 32px rgba(0,0,0,0.5);animation:slideUp 0.35s ease-out';
  div.innerHTML=`
    <div style="font-size:32px">🇩🇪</div>
    <div style="flex:1"><div style="font-weight:700;font-size:15px">ثبّت التطبيق</div><div style="font-size:13px;color:var(--text2)">للوصول السريع بدون إنترنت</div></div>
    <button class="btn btn-sm btn-primary" id="install-btn" style="flex-shrink:0">تثبيت</button>
    <button class="btn btn-sm btn-ghost" id="install-dismiss" style="flex-shrink:0">تخطي</button>`;
  document.body.appendChild(div);
  el('install-btn').onclick=()=>{
    if(deferredPrompt){deferredPrompt.prompt();deferredPrompt.userChoice.then(()=>{deferredPrompt=null;div.remove();});}
  };
  el('install-dismiss').onclick=()=>div.remove();
}

// ═══════════════════════════════════════════════════
// FOCUS MANAGEMENT
// ═══════════════════════════════════════════════════
let lastFocus=null;
function trapFocus(container){
  const focusable=container.querySelectorAll('button,[href],input,select,textarea,[tabindex]:not([tabindex="-1"])');
  if(!focusable.length)return;
  const first=focusable[0],last=focusable[focusable.length-1];
  container.addEventListener('keydown',function handler(e){
    if(e.key!=='Tab')return;
    if(e.shiftKey&&document.activeElement===first){e.preventDefault();last.focus();}
    else if(!e.shiftKey&&document.activeElement===last){e.preventDefault();first.focus();}
  });
}
function openModal(id){
  lastFocus=document.activeElement;
  const modal=el(id);
  if(!modal)return;
  modal.classList.add('show');
  trapFocus(modal);
  const firstBtn=modal.querySelector('button');
  if(firstBtn)setTimeout(()=>firstBtn.focus(),100);
}
function closeModal(id){
  const modal=el(id);
  if(modal)modal.classList.remove('show');
  if(lastFocus)setTimeout(()=>lastFocus.focus(),50);
}

// ═══════════════════════════════════════════════════
// INIT
// ═══════════════════════════════════════════════════
function init(){
  loadState();
  initOnboarding();
  registerSW();
  if(state.onboardingDone){
    el('onboarding').classList.add('hidden');
    el('app').style.display='flex';
    updateHomeUI();
    initLessons();
    initVocab();
  }
  // Keyboard support
  document.addEventListener('keydown',e=>{
    if(currentScreen==='flashcards'){
      if(e.key==='ArrowRight'||e.key===' '){e.preventDefault();if(!fcFlipped)flipCard();else rateCard('easy');}
      if(e.key==='ArrowLeft'){e.preventDefault();showScreen('home');}
      if(e.key==='1'&&fcFlipped)rateCard('easy');
      if(e.key==='2'&&fcFlipped)rateCard('medium');
      if(e.key==='3'&&fcFlipped)rateCard('hard');
    }
    if(e.key==='Escape'){
      if(el('word-modal').classList.contains('show'))el('word-modal').classList.remove('show');
      else if(currentScreen==='quiz'||currentScreen==='flashcards'||currentScreen==='speaking')showScreen('home');
    }
    // Nav shortcuts
    if(e.altKey){
      const navMap={'1':'home','2':'vocabulary','3':'lessons','4':'quiz','5':'profile'};
      if(navMap[e.key]){e.preventDefault();navTo(navMap[e.key]);}
    }
  });
  // Focus trap for word modal
  el('word-modal').addEventListener('keydown',e=>{
    if(e.key==='Escape')closeModal('word-modal');
  });
}
document.addEventListener('DOMContentLoaded',init);
</script>

<!--
═══════════════════════════════════════════════════════════════
FINAL_LANGUAGE_LEARNING_PRODUCTION_REPORT
═══════════════════════════════════════════════════════════════

APP: ألمانيتي (Almaniyati) — German Learning App for Arabic Speakers
VERSION: 2.0.0
PLATFORM: Full PWA, Single File HTML + Service Worker + Manifest

──────────────────────────────────────────────────────────────
FEATURES IMPLEMENTED
──────────────────────────────────────────────────────────────
✅ Home Dashboard
   - Daily goal progress (10 words/day)
   - Learning streak with fire emoji
   - XP system with floating animations
   - Level badge with ring progress
   - Quick action grid (Flashcards, Quiz, Listening, Speaking)
