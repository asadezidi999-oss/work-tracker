        <div class="progress-bar"><div class="progress-fill" id="ld-progress" style="width:0%"></div></div>
        <div style="text-align:center;font-size:13px;color:var(--text2);margin-top:6px" id="ld-step-label">1 من 5</div>
      </div>
      <div style="flex:1;overflow-y:auto;padding:16px;padding-bottom:120px" id="ld-content">
        <!-- rendered by JS -->
      </div>
      <div style="padding:16px;background:var(--bg);border-top:1px solid var(--border);padding-bottom:calc(var(--safe-bottom)+16px)">
        <button class="btn btn-primary" style="width:100%" id="ld-next-btn" onclick="nextLessonStep()">التالي</button>
      </div>
    </div>
  </div>

  <!-- BOTTOM NAV -->
  <nav id="bottom-nav" role="tablist" aria-label="التنقل الرئيسي">
