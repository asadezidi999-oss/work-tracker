<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="ألمانيتي">
<meta name="theme-color" content="#0a0a0f">
<meta name="mobile-web-app-capable" content="yes">
<link rel="manifest" href="manifest.json">
<title>ألمانيتي — تعلم الألمانية</title>
<style>
:root {
  --bg: #0a0a0f;
  --bg2: #12121a;
  --bg3: #1a1a26;
  --card: #16161f;
  --card2: #1e1e2e;
  --border: rgba(255,255,255,0.08);
  --border2: rgba(255,255,255,0.14);
  --text: #f0f0f5;
  --text2: #a0a0b8;
  --text3: #60607a;
  --accent: #6c63ff;
  --accent2: #8b83ff;
  --accent3: rgba(108,99,255,0.15);
  --green: #30d158;
  --green2: rgba(48,209,88,0.15);
  --red: #ff453a;
  --red2: rgba(255,69,58,0.15);
  --yellow: #ffd60a;
  --yellow2: rgba(255,214,10,0.15);
  --orange: #ff9f0a;
  --blue: #0a84ff;
  --teal: #5ac8fa;
  --pink: #ff375f;
  --radius: 16px;
  --radius2: 12px;
  --radius3: 22px;
  --safe-top: env(safe-area-inset-top, 44px);
  --safe-bottom: env(safe-area-inset-bottom, 34px);
  --nav-height: 83px;
  --header-height: 56px;
  --font: -apple-system, "SF Pro Display", "SF Pro Text", BlinkMacSystemFont, system-ui, sans-serif;
}
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0;-webkit-tap-highlight-color:transparent}
html{height:100%;overflow:hidden;scroll-behavior:smooth}
body{
  background:var(--bg);
  color:var(--text);
  font-family:var(--font);
  font-size:16px;
  line-height:1.5;
  height:100%;
  overflow:hidden;
  -webkit-font-smoothing:antialiased;
  -moz-osx-font-smoothing:grayscale;
  overscroll-behavior:none;
  user-select:none;
}
#app{
  position:fixed;
  inset:0;
  display:flex;
  flex-direction:column;
  overflow:hidden;
}
.screen{
  position:absolute;
  inset:0;
  display:flex;
  flex-direction:column;
  overflow:hidden;
  opacity:0;
  pointer-events:none;
  transition:opacity 0.28s cubic-bezier(0.4,0,0.2,1),transform 0.28s cubic-bezier(0.4,0,0.2,1);
  transform:translateX(30px);
}
.screen.active{
  opacity:1;
  pointer-events:all;
  transform:translateX(0);
}
.screen.exit{
  opacity:0;
  transform:translateX(-30px);
}
/* SCROLLABLE CONTENT AREA */
.scroll-area{
  flex:1;
  overflow-y:auto;
  overflow-x:hidden;
  -webkit-overflow-scrolling:touch;
  scroll-behavior:smooth;
  padding-bottom:calc(var(--nav-height) + var(--safe-bottom) + 20px);
}
.scroll-area::-webkit-scrollbar{display:none}

/* TOP NAV / STATUS BAR SPACER */
.status-bar{height:var(--safe-top);background:transparent;flex-shrink:0}
.header{
  height:var(--header-height);
  display:flex;
  align-items:center;
  justify-content:space-between;
  padding:0 20px;
  flex-shrink:0;
  background:rgba(10,10,15,0.8);
  backdrop-filter:blur(20px) saturate(180%);
  -webkit-backdrop-filter:blur(20px) saturate(180%);
  border-bottom:1px solid var(--border);
  position:relative;
  z-index:10;
}
.header-title{
  font-size:17px;
  font-weight:600;
  letter-spacing:-0.4px;
  text-align:center;
  flex:1;
}
.header-btn{
  width:44px;
  height:44px;
  display:flex;
  align-items:center;
  justify-content:center;
  border-radius:50%;
  background:none;
  border:none;
  color:var(--accent2);
  cursor:pointer;
  font-size:20px;
  transition:background 0.15s;
}
.header-btn:active{background:var(--border)}

/* BOTTOM NAV */
#bottom-nav{
  position:fixed;
  bottom:0;
  left:0;
  right:0;
  height:var(--nav-height);
  background:rgba(16,16,22,0.9);
  backdrop-filter:blur(24px) saturate(180%);
  -webkit-backdrop-filter:blur(24px) saturate(180%);
  border-top:1px solid var(--border);
  display:flex;
  align-items:flex-start;
  padding-top:8px;
  padding-bottom:var(--safe-bottom);
  z-index:1000;
}
.nav-item{
  flex:1;
  display:flex;
  flex-direction:column;
  align-items:center;
  gap:4px;
  padding:4px 0;
  cursor:pointer;
  background:none;
  border:none;
  color:var(--text3);
  transition:color 0.2s;
  min-height:44px;
}
.nav-item.active{color:var(--accent2)}
.nav-icon{
  width:26px;
  height:26px;
  display:flex;
  align-items:center;
  justify-content:center;
  font-size:22px;
  transition:transform 0.2s cubic-bezier(0.34,1.56,0.64,1);
}
.nav-item.active .nav-icon{transform:scale(1.15)}
.nav-label{font-size:10px;font-weight:500;letter-spacing:0.2px}

/* CARDS */
.card{
  background:var(--card);
  border-radius:var(--radius);
  border:1px solid var(--border);
  overflow:hidden;
}
.card2{
  background:var(--card2);
  border-radius:var(--radius2);
  border:1px solid var(--border);
}
.glass{
  background:rgba(255,255,255,0.04);
  backdrop-filter:blur(20px);
  -webkit-backdrop-filter:blur(20px);
  border:1px solid var(--border2);
  border-radius:var(--radius);
}

/* SECTION */
.section{padding:0 16px;margin-bottom:28px}
.section-header{
  display:flex;
  align-items:center;
  justify-content:space-between;
  margin-bottom:12px;
}
.section-title{
  font-size:20px;
  font-weight:700;
  letter-spacing:-0.5px;
}
.section-link{
  font-size:15px;
  color:var(--accent2);
  font-weight:500;
  background:none;
  border:none;
  cursor:pointer;
}

/* BUTTONS */
.btn{
  display:flex;
  align-items:center;
  justify-content:center;
  gap:8px;
  height:54px;
  border-radius:var(--radius2);
  font-family:var(--font);
  font-size:17px;
  font-weight:600;
  border:none;
  cursor:pointer;
  transition:transform 0.1s,filter 0.1s;
  letter-spacing:-0.3px;
}
.btn:active{transform:scale(0.97);filter:brightness(0.9)}
.btn-primary{background:var(--accent);color:#fff}
.btn-secondary{background:var(--card2);color:var(--text);border:1px solid var(--border2)}
.btn-ghost{background:none;color:var(--accent2);border:none}
.btn-sm{height:40px;font-size:15px;border-radius:10px;padding:0 16px}
.btn-danger{background:var(--red2);color:var(--red)}
.btn-success{background:var(--green2);color:var(--green)}
.btn-icon{
  width:44px;
  height:44px;
  border-radius:50%;
  background:var(--card2);
  border:1px solid var(--border);
  display:flex;
  align-items:center;
  justify-content:center;
  cursor:pointer;
  font-size:20px;
  flex-shrink:0;
  transition:transform 0.1s,background 0.15s;
}
.btn-icon:active{transform:scale(0.92);background:var(--border)}

/* CHIPS */
.chip{
  display:inline-flex;
  align-items:center;
  gap:6px;
  padding:6px 14px;
  border-radius:100px;
  font-size:13px;
  font-weight:600;
  border:none;
  cursor:pointer;
  white-space:nowrap;
  transition:all 0.15s;
}
.chip-active{background:var(--accent);color:#fff}
.chip-default{background:var(--card2);color:var(--text2);border:1px solid var(--border)}

/* PROGRESS BAR */
.progress-bar{
  height:8px;
  background:var(--bg3);
  border-radius:100px;
  overflow:hidden;
}
.progress-fill{
  height:100%;
  background:linear-gradient(90deg,var(--accent),var(--accent2));
  border-radius:100px;
  transition:width 0.6s cubic-bezier(0.4,0,0.2,1);
}
.progress-fill.green{background:linear-gradient(90deg,#28b84a,var(--green))}
.progress-fill.yellow{background:linear-gradient(90deg,var(--orange),var(--yellow))}

/* XP/STREAK BADGE */
.badge{
  display:inline-flex;
  align-items:center;
  gap:5px;
  padding:5px 12px;
  border-radius:100px;
  font-size:13px;
  font-weight:700;
}

/* TAGS */
.tag{
  display:inline-flex;
  padding:3px 10px;
  border-radius:100px;
  font-size:11px;
  font-weight:700;
  letter-spacing:0.4px;
  text-transform:uppercase;
}
.tag-easy{background:var(--green2);color:var(--green)}
.tag-medium{background:var(--yellow2);color:var(--yellow)}
.tag-hard{background:var(--red2);color:var(--red)}
.tag-new{background:var(--accent3);color:var(--accent2)}

/* INPUT */
.input-field{
  width:100%;
  height:54px;
  background:var(--card2);
  border:1.5px solid var(--border2);
  border-radius:var(--radius2);
  color:var(--text);
  font-family:var(--font);
  font-size:17px;
  padding:0 16px;
  outline:none;
  transition:border-color 0.2s;
  -webkit-appearance:none;
}
.input-field:focus{border-color:var(--accent)}
.input-field::placeholder{color:var(--text3)}

/* WORD CARD */
.word-card{
  background:var(--card);
  border-radius:var(--radius3);
  border:1px solid var(--border);
  padding:20px;
  display:flex;
  align-items:center;
  gap:16px;
  cursor:pointer;
  transition:transform 0.15s,background 0.15s;
  min-height:80px;
}
.word-card:active{transform:scale(0.98);background:var(--card2)}
.word-emoji{
  width:52px;
  height:52px;
  border-radius:14px;
  background:var(--accent3);
  display:flex;
  align-items:center;
  justify-content:center;
  font-size:26px;
  flex-shrink:0;
}
.word-de{font-size:19px;font-weight:700;letter-spacing:-0.4px;direction:ltr;text-align:left}
.word-ar{font-size:14px;color:var(--text2);margin-top:3px}
.word-card-right{margin-right:auto}

/* TOAST */
#toast{
  position:fixed;
  top:calc(var(--safe-top) + 8px);
  left:50%;
  transform:translateX(-50%) translateY(-120px);
  background:rgba(30,30,46,0.95);
  backdrop-filter:blur(20px);
  -webkit-backdrop-filter:blur(20px);
  border:1px solid var(--border2);
  border-radius:var(--radius2);
  padding:12px 20px;
  font-size:14px;
  font-weight:600;
  color:var(--text);
  z-index:9999;
  transition:transform 0.35s cubic-bezier(0.34,1.56,0.64,1);
  white-space:nowrap;
  max-width:calc(100vw - 40px);
  text-align:center;
}
#toast.show{transform:translateX(-50%) translateY(0)}

/* MODAL */
.modal-overlay{
  position:fixed;
  inset:0;
  background:rgba(0,0,0,0.6);
  backdrop-filter:blur(8px);
  -webkit-backdrop-filter:blur(8px);
  z-index:5000;
  display:flex;
  align-items:flex-end;
  opacity:0;
  pointer-events:none;
  transition:opacity 0.25s;
}
.modal-overlay.show{opacity:1;pointer-events:all}
.modal-sheet{
  width:100%;
  background:var(--bg2);
  border-radius:28px 28px 0 0;
  padding:20px 20px calc(var(--safe-bottom) + 20px);
  border-top:1px solid var(--border2);
  transform:translateY(100%);
  transition:transform 0.35s cubic-bezier(0.4,0,0.2,1);
  max-height:92vh;
  overflow-y:auto;
}
.modal-overlay.show .modal-sheet{transform:translateY(0)}
.modal-handle{
  width:40px;
  height:5px;
  background:var(--border2);
  border-radius:100px;
  margin:0 auto 20px;
}

/* DIVIDER */
.divider{height:1px;background:var(--border);margin:0 16px}

/* STAT GRID */
.stat-grid{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:12px;
}
.stat-card{
  background:var(--card);
  border-radius:var(--radius);
  border:1px solid var(--border);
  padding:16px;
  display:flex;
  flex-direction:column;
  gap:6px;
}
.stat-value{font-size:28px;font-weight:800;letter-spacing:-1px}
.stat-label{font-size:13px;color:var(--text2);font-weight:500}

/* SCROLL X */
.scroll-x{
  display:flex;
  gap:10px;
  overflow-x:auto;
  padding:4px 16px;
  -webkit-overflow-scrolling:touch;
  scrollbar-width:none;
}
.scroll-x::-webkit-scrollbar{display:none}

/* ONBOARDING */
#onboarding{
  position:fixed;
  inset:0;
  background:var(--bg);
  z-index:8000;
  display:flex;
  flex-direction:column;
  align-items:center;
  justify-content:center;
  padding:40px 24px calc(var(--safe-bottom)+40px);
  transition:opacity 0.6s cubic-bezier(0.22,1,0.36,1),transform 0.6s cubic-bezier(0.22,1,0.36,1);
}
#onboarding.hidden{opacity:0;pointer-events:none;transform:scale(0.95)}
#onboarding::before{
  content:'';position:absolute;top:-50%;left:-50%;width:200%;height:200%;
  background:radial-gradient(ellipse at 50% 30%,rgba(108,99,255,0.08),transparent 60%);
  pointer-events:none;
}
.onboard-slide{
  display:none;
  flex-direction:column;
  align-items:center;
  text-align:center;
  animation:fadeUp 0.6s cubic-bezier(0.22,1,0.36,1);
  max-width:340px;
}
.onboard-slide.active{display:flex}
@keyframes fadeUp{from{opacity:0;transform:translateY(24px) scale(0.97)}to{opacity:1;transform:translateY(0) scale(1)}}
.onboard-emoji{
  font-size:96px;
  margin-bottom:24px;
  filter:drop-shadow(0 8px 40px rgba(108,99,255,0.35));
  transition:transform 0.6s cubic-bezier(0.34,1.56,0.64,1);
}
.onboard-slide.active .onboard-emoji{animation:float 3s ease-in-out infinite}
@keyframes float{0%,100%{transform:translateY(0)}50%{transform:translateY(-8px)}}
.onboard-title{
  font-size:34px;
  font-weight:800;
  letter-spacing:-1px;
  margin-bottom:12px;
  line-height:1.15;
  background:linear-gradient(135deg,#f0f0f5 0%,#a78bfa 100%);
  -webkit-background-clip:text;-webkit-text-fill-color:transparent;
}
.onboard-sub{
  font-size:17px;
  color:var(--text2);
  line-height:1.6;
  max-width:300px;
  -webkit-text-fill-color:var(--text2);
}
.onboard-dots{display:flex;gap:10px;margin:36px 0}
.onboard-dot{
  width:8px;height:8px;border-radius:50%;
  background:var(--border2);transition:all 0.4s cubic-bezier(0.34,1.56,0.64,1);
  cursor:pointer;
}
.onboard-dot.active{background:var(--accent);width:28px;border-radius:4px;box-shadow:0 0 12px rgba(108,99,255,0.4)}
.onboard-actions{width:100%;display:flex;flex-direction:column;gap:12px;margin-top:auto}

/* LEVEL BADGE */
.level-ring{
  width:64px;height:64px;border-radius:50%;
  background:conic-gradient(var(--accent) 0% var(--pct,40%),var(--bg3) var(--pct,40%) 100%);
  display:flex;align-items:center;justify-content:center;
  position:relative;flex-shrink:0;
}
.level-ring::after{
  content:'';position:absolute;inset:5px;border-radius:50%;background:var(--card);
}
.level-ring-text{
  position:relative;z-index:1;font-size:18px;font-weight:800;
}

/* FLASHCARD */
.flashcard{
  width:calc(100vw - 32px);
  min-height:320px;
  background:var(--card);
  border-radius:var(--radius3);
  border:1px solid var(--border2);
  display:flex;
  flex-direction:column;
  align-items:center;
  justify-content:center;
  padding:32px 24px;
  text-align:center;
  position:relative;
  cursor:pointer;
  transition:transform 0.6s cubic-bezier(0.4,0,0.2,1);
  transform-style:preserve-3d;
}
.fc-front,.fc-back{
  position:absolute;inset:0;
  display:flex;flex-direction:column;
  align-items:center;justify-content:center;
  padding:32px 24px;
  backface-visibility:hidden;
  -webkit-backface-visibility:hidden;
}
.fc-back{transform:rotateY(180deg)}
.flashcard.flipped{transform:rotateY(180deg)}
.fc-de{font-size:36px;font-weight:800;letter-spacing:-1px;direction:ltr}
.fc-ar{font-size:24px;font-weight:600;color:var(--text2)}
.fc-example{font-size:14px;color:var(--text3);margin-top:16px;direction:ltr;line-height:1.6}
.fc-hint{font-size:13px;color:var(--text3);position:absolute;bottom:20px}

/* QUIZ */
.quiz-option{
  display:flex;
  align-items:center;
  gap:14px;
  padding:16px;
  background:var(--card);
  border-radius:var(--radius2);
  border:1.5px solid var(--border);
  cursor:pointer;
  transition:all 0.2s;
  min-height:56px;
  font-size:16px;
  font-weight:500;
}
.quiz-option.correct{background:var(--green2);border-color:var(--green);color:var(--green)}
.quiz-option.wrong{background:var(--red2);border-color:var(--red);color:var(--red)}
.quiz-option.selected{border-color:var(--accent);background:var(--accent3)}
.quiz-option:active:not(.correct):not(.wrong){transform:scale(0.98)}
.quiz-letter{
  width:32px;height:32px;border-radius:8px;
  background:var(--bg3);display:flex;align-items:center;justify-content:center;
  font-size:13px;font-weight:700;flex-shrink:0;color:var(--text2);
}

/* ACHIEVEMENT */
.achievement-card{
  display:flex;align-items:center;gap:14px;
  background:var(--card);border-radius:var(--radius2);
  border:1px solid var(--border);padding:14px 16px;
  min-height:72px;
}
.ach-icon{
  width:48px;height:48px;border-radius:14px;
  display:flex;align-items:center;justify-content:center;
  font-size:26px;flex-shrink:0;
}
.ach-locked{filter:grayscale(1);opacity:0.4}

/* ANIMATIONS */
@keyframes pulse{
  0%,100%{transform:scale(1)}
  50%{transform:scale(1.05)}
}
@keyframes shake{
  0%,100%{transform:translateX(0)}
  20%,60%{transform:translateX(-8px)}
  40%,80%{transform:translateX(8px)}
}
@keyframes bounceIn{
  0%{transform:scale(0.5);opacity:0}
  60%{transform:scale(1.1)}
  100%{transform:scale(1);opacity:1}
}
@keyframes slideUp{
  from{transform:translateY(20px);opacity:0}
  to{transform:translateY(0);opacity:1}
}
@keyframes xpFloat{
  0%{opacity:1;transform:translateY(0) scale(1)}
  100%{opacity:0;transform:translateY(-60px) scale(1.4)}
}
.xp-float{
  position:fixed;
  color:var(--yellow);
  font-size:20px;
  font-weight:800;
  pointer-events:none;
  z-index:9000;
  animation:xpFloat 1.2s ease-out forwards;
}
.bounce-in{animation:bounceIn 0.4s cubic-bezier(0.34,1.56,0.64,1)}
.slide-up{animation:slideUp 0.4s ease-out}

/* GRADIENT BACKGROUNDS */
.gradient-accent{background:linear-gradient(135deg,#6c63ff 0%,#a78bfa 100%)}
.gradient-green{background:linear-gradient(135deg,#28b84a 0%,#30d158 100%)}
.gradient-orange{background:linear-gradient(135deg,#ff6b35 0%,#ff9f0a 100%)}
.gradient-blue{background:linear-gradient(135deg,#0a84ff 0%,#5ac8fa 100%)}
.gradient-pink{background:linear-gradient(135deg,#ff375f 0%,#ff6b9d 100%)}

/* WAVEFORM ANIMATION */
.wave-bars{display:flex;align-items:center;gap:3px;height:30px}
.wave-bar{
  width:4px;border-radius:2px;background:var(--accent);
  animation:wave 0.8s ease-in-out infinite;
}
.wave-bar:nth-child(1){animation-delay:0s;height:8px}
.wave-bar:nth-child(2){animation-delay:0.1s;height:18px}
.wave-bar:nth-child(3){animation-delay:0.2s;height:24px}
.wave-bar:nth-child(4){animation-delay:0.15s;height:16px}
.wave-bar:nth-child(5){animation-delay:0.05s;height:10px}
@keyframes wave{
  0%,100%{transform:scaleY(0.5)}
  50%{transform:scaleY(1)}
}
.wave-bars.paused .wave-bar{animation-play-state:paused}

/* SPEAK CIRCLE */
.speak-circle{
  width:120px;height:120px;border-radius:50%;
  display:flex;align-items:center;justify-content:center;
  position:relative;cursor:pointer;
  background:var(--accent3);
  border:2px solid var(--accent);
  transition:all 0.3s;
}
.speak-circle.recording{
  background:rgba(255,69,58,0.15);
  border-color:var(--red);
  animation:pulse 1s ease-in-out infinite;
}
.speak-icon{font-size:48px;pointer-events:none}

/* STREAK FIRE */
.streak-display{
  display:flex;align-items:center;gap:8px;
  background:var(--yellow2);
  border-radius:100px;padding:8px 16px;
}
.streak-num{font-size:22px;font-weight:800;color:var(--yellow)}

/* CATEGORY PILL */
.cat-pill{
  display:flex;flex-direction:column;align-items:center;gap:8px;
  padding:16px 12px;min-width:80px;
  background:var(--card);border-radius:var(--radius2);
  border:1px solid var(--border);cursor:pointer;
  transition:all 0.15s;flex-shrink:0;
}
.cat-pill:active{transform:scale(0.95);background:var(--card2)}
.cat-pill.selected{background:var(--accent3);border-color:var(--accent)}
.cat-emoji{font-size:28px}
.cat-name{font-size:11px;font-weight:600;color:var(--text2);text-align:center}

/* LESSON CARD */
.lesson-card{
  background:var(--card);border-radius:var(--radius);
  border:1px solid var(--border);padding:20px;
  display:flex;align-items:center;gap:16px;cursor:pointer;
  transition:all 0.15s;
}
.lesson-card:active{transform:scale(0.98);background:var(--card2)}
.lesson-num{
  width:48px;height:48px;border-radius:14px;
  display:flex;align-items:center;justify-content:center;
  font-size:20px;font-weight:800;flex-shrink:0;
}
.lesson-info{flex:1}
.lesson-title{font-size:17px;font-weight:700;letter-spacing:-0.3px}
.lesson-sub{font-size:13px;color:var(--text2);margin-top:2px}
.lesson-stars{display:flex;gap:3px;margin-top:6px}
.lesson-star{font-size:14px;opacity:0.3}
.lesson-star.earned{opacity:1}
.lesson-locked{opacity:0.45;pointer-events:none}

/* WORD DETAIL SHEET */
.word-detail-de{font-size:40px;font-weight:800;letter-spacing:-1.5px;direction:ltr;text-align:center}
.word-detail-ar{font-size:24px;color:var(--text2);text-align:center;margin-top:8px}
.word-detail-rom{font-size:16px;color:var(--text3);text-align:center;font-style:italic;direction:ltr}

/* SETTINGS ROW */
.settings-row{
  display:flex;align-items:center;gap:14px;
  padding:14px 16px;min-height:56px;cursor:pointer;
  transition:background 0.15s;
}
.settings-row:active{background:var(--border)}
.settings-icon{
  width:32px;height:32px;border-radius:8px;
  display:flex;align-items:center;justify-content:center;font-size:16px;flex-shrink:0;
}
.settings-label{flex:1;font-size:16px;font-weight:500}
.settings-value{font-size:15px;color:var(--text2)}
.toggle{
  width:52px;height:32px;border-radius:16px;
  background:var(--bg3);position:relative;cursor:pointer;
  border:none;transition:background 0.3s;flex-shrink:0;
}
.toggle.on{background:var(--green)}
.toggle-knob{
  width:26px;height:26px;border-radius:50%;background:#fff;
  position:absolute;top:3px;left:3px;
  transition:transform 0.3s cubic-bezier(0.34,1.56,0.64,1);
  box-shadow:0 2px 8px rgba(0,0,0,0.3);
}
.toggle.on .toggle-knob{transform:translateX(20px)}

/* SEARCH */
.search-bar{
  display:flex;align-items:center;gap:10px;
  background:var(--card2);border-radius:var(--radius2);
  border:1.5px solid var(--border);padding:0 14px;
  height:48px;margin:0 16px;transition:border-color 0.2s;
}
.search-bar:focus-within{border-color:var(--accent)}
.search-bar input{
  flex:1;background:none;border:none;outline:none;
  color:var(--text);font-family:var(--font);font-size:16px;
  direction:rtl;
}
.search-bar input::placeholder{color:var(--text3)}

/* PROFILE HEADER */
.profile-hero{
  background:linear-gradient(180deg,rgba(108,99,255,0.2) 0%,transparent 100%);
  padding:24px 20px;display:flex;flex-direction:column;align-items:center;gap:12px;
}
.avatar{
  width:80px;height:80px;border-radius:50%;
  background:var(--accent3);border:3px solid var(--accent);
  display:flex;align-items:center;justify-content:center;font-size:36px;
}
.profile-name{font-size:24px;font-weight:800;letter-spacing:-0.5px}
.profile-sub{font-size:14px;color:var(--text2)}

/* MATCH GAME */
.match-grid{
  display:grid;grid-template-columns:1fr 1fr;gap:10px;
}
.match-card{
  background:var(--card);border-radius:var(--radius2);
  border:1.5px solid var(--border);padding:14px 10px;
  text-align:center;font-size:15px;font-weight:600;
  cursor:pointer;min-height:54px;display:flex;
  align-items:center;justify-content:center;
  transition:all 0.2s;line-height:1.3;
}
.match-card.selected{background:var(--accent3);border-color:var(--accent);color:var(--accent2)}
.match-card.matched{background:var(--green2);border-color:var(--green);color:var(--green);pointer-events:none}
.match-card.wrong{background:var(--red2);border-color:var(--red);animation:shake 0.3s ease-out}

/* FILL BLANK */
.blank{
  display:inline-block;min-width:80px;border-bottom:2px solid var(--accent);
  color:var(--accent);font-weight:700;text-align:center;padding:0 4px;
}

/* LISTENING PLAYER */
.player-card{
  background:linear-gradient(135deg,var(--accent3),rgba(91,131,255,0.1));
  border-radius:var(--radius3);border:1px solid var(--accent);
  padding:24px;display:flex;flex-direction:column;align-items:center;gap:16px;
}
.player-text{
  font-size:22px;font-weight:700;letter-spacing:-0.5px;
  direction:ltr;text-align:center;line-height:1.4;
}
.player-speed{
  display:flex;gap:8px;align-items:center;
}
.speed-btn{
  padding:6px 14px;border-radius:100px;font-size:13px;font-weight:700;
  border:none;cursor:pointer;background:var(--card2);color:var(--text2);
  transition:all 0.15s;
}
.speed-btn.active{background:var(--accent);color:#fff}

/* FOCUS VISIBLE */
:focus{outline:none}
:focus-visible{outline:2px solid var(--accent);outline-offset:2px;border-radius:4px}
.nav-item:focus-visible,.btn:focus-visible,.btn-icon:focus-visible,.header-btn:focus-visible{outline-offset:3px}
.btn:focus-visible{box-shadow:0 0 0 3px var(--accent3)}

/* SKIP LINK */
.skip-link{
  position:fixed;top:-100px;left:16px;z-index:99999;
  background:var(--accent);color:#fff;padding:12px 20px;
  border-radius:12px;font-size:15px;font-weight:600;
  transition:top 0.3s;
}
.skip-link:focus{top:16px}

/* REDUCED MOTION */
@media(prefers-reduced-motion:reduce){
  *,.screen,.flashcard,.modal-sheet,#toast,.xp-float,.bounce-in,.slide-up,.streak-display,.progress-fill{animation:none!important;transition-duration:0.01ms!important;transform:none!important}
}

/* SR ONLY */
.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);border:0}

/* RESPONSIVE */
@media(min-width:430px){
  .section{padding:0 20px}
}

/* ENHANCED ANIMATIONS */
.screen{transition:opacity 0.35s cubic-bezier(0.22,1,0.36,1),transform 0.35s cubic-bezier(0.22,1,0.36,1)}
.nav-item.active .nav-icon{transform:scale(1.15);transition:transform 0.35s cubic-bezier(0.34,1.56,0.64,1)}
.flashcard{transition:transform 0.5s cubic-bezier(0.22,1,0.36,1)}
.modal-sheet{transition:transform 0.4s cubic-bezier(0.22,1,0.36,1)}
.modal-overlay{transition:opacity 0.3s ease}
.progress-fill{transition:width 0.7s cubic-bezier(0.22,1,0.36,1)}
#toast{transition:transform 0.4s cubic-bezier(0.34,1.56,0.64,1)}
.word-card,.lesson-card,.cat-pill,.quiz-option,.settings-row,.achievement-card{transition:transform 0.12s,background 0.15s,border-color 0.15s}
</style>
</head>
<body>

<a href="#app" class="skip-link">تخطي إلى المحتوى الرئيسي</a>
<div id="toast" role="status" aria-live="polite" aria-atomic="true"></div>

<!-- ONBOARDING -->
<div id="onboarding">
  <div id="slide-0" class="onboard-slide active">
    <div class="onboard-emoji">🇩🇪</div>
    <h1 class="onboard-title">مرحباً بك في<br>ألمانيتي</h1>
    <p class="onboard-sub">تعلّم الألمانية بطريقة ممتعة وفعّالة — من المبتدئ إلى المتقدم</p>
  </div>
  <div id="slide-1" class="onboard-slide">
    <div class="onboard-emoji">🎯</div>
    <h1 class="onboard-title">دروس ذكية<br>يومية</h1>
    <p class="onboard-sub">5 دقائق يومياً تكفي لتتعلم مفردات وجمل حقيقية</p>
  </div>
  <div id="slide-2" class="onboard-slide">
    <div class="onboard-emoji">🎤</div>
    <h1 class="onboard-title">انطق بثقة<br>من اليوم الأول</h1>
    <p class="onboard-sub">تقنية التعرف على الصوت تساعدك على نطق الألمانية بشكل صحيح</p>
  </div>
  <div id="slide-3" class="onboard-slide">
    <div class="onboard-emoji">🏆</div>
    <h1 class="onboard-title">اربح نقاطاً<br>وشارات</h1>
    <p class="onboard-sub">نظام المكافآت والإنجازات يجعل التعلم ممتعاً كل يوم</p>
  </div>
  <div class="onboard-dots">
    <div class="onboard-dot active" id="dot-0"></div>
    <div class="onboard-dot" id="dot-1"></div>
    <div class="onboard-dot" id="dot-2"></div>
    <div class="onboard-dot" id="dot-3"></div>
  </div>
  <div class="onboard-actions">
    <button class="btn btn-primary" id="onboard-next">التالي</button>
    <button class="btn btn-ghost" id="onboard-skip">تخطي</button>
  </div>
</div>

<!-- APP -->
<div id="app" style="display:none">
  <!-- HOME SCREEN -->
  <div class="screen active" id="screen-home">
    <div class="status-bar"></div>
    <div class="header">
      <div style="width:44px"></div>
      <div class="header-title" style="font-size:22px;font-weight:800;background:linear-gradient(135deg,#a78bfa,#6c63ff);-webkit-background-clip:text;-webkit-text-fill-color:transparent">ألمانيتي</div>
      <button class="btn-icon" onclick="showScreen('profile')" aria-label="الملف الشخصي">👤</button>
    </div>
    <div class="scroll-area" id="home-scroll">
      <!-- STREAK / XP HERO -->
      <div style="padding:16px 16px 8px">
        <div class="card" style="background:linear-gradient(135deg,rgba(108,99,255,0.25),rgba(108,99,255,0.08));border-color:rgba(108,99,255,0.3);padding:20px">
          <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:16px">
            <div>
              <div style="font-size:13px;color:var(--text2);margin-bottom:4px">مرحباً، المتعلم! 👋</div>
              <div style="font-size:22px;font-weight:800;letter-spacing:-0.5px">واصل التعلم اليوم</div>
            </div>
            <div class="streak-display">
              <span>🔥</span>
              <span class="streak-num" id="home-streak">0</span>
              <span style="font-size:13px;color:var(--text2);font-weight:600">يوم</span>
            </div>
          </div>
          <!-- Daily goal progress -->
          <div style="margin-bottom:10px">
            <div style="display:flex;justify-content:space-between;margin-bottom:8px">
              <span style="font-size:13px;color:var(--text2)">الهدف اليومي</span>
              <span style="font-size:13px;font-weight:700;color:var(--accent2)" id="daily-goal-text">0 / 10 كلمات</span>
            </div>
            <div class="progress-bar"><div class="progress-fill" id="daily-progress-fill" style="width:0%"></div></div>
          </div>
          <div style="display:flex;gap:12px;flex-wrap:wrap">
            <div class="badge" style="background:var(--yellow2);color:var(--yellow)">⭐ <span id="home-xp">0</span> XP</div>
            <div class="badge" style="background:var(--accent3);color:var(--accent2)">📚 <span id="home-words">0</span> كلمة</div>
            <div class="badge" style="background:var(--green2);color:var(--green)">🎯 المستوى <span id="home-level">1</span></div>
            <div class="badge" style="background:var(--blue);color:#fff;display:none" id="due-badge">🔄 <span id="due-count">0</span> للمراجعة</div>
          </div>
        </div>
      </div>

      <!-- DAILY CHALLENGES -->
      <div class="section">
        <div class="section-header">
          <div class="section-title">تحديات اليوم</div>
        </div>
        <div style="display:flex;flex-direction:column;gap:10px" id="challenges-list">
          <!-- rendered by JS -->
        </div>
      </div>

      <!-- QUICK ACTIONS -->
      <div class="section">
        <div class="section-header"><div class="section-title">تمرّن الآن</div></div>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px">
          <button class="card" style="padding:20px;text-align:center;cursor:pointer;border:none;background:linear-gradient(135deg,rgba(108,99,255,0.2),rgba(108,99,255,0.05))" onclick="showScreen('flashcards')">
            <div style="font-size:36px;margin-bottom:8px">🃏</div>
            <div style="font-size:15px;font-weight:700">البطاقات</div>
            <div style="font-size:12px;color:var(--text2);margin-top:2px">مراجعة المفردات</div>
          </button>
          <button class="card" style="padding:20px;text-align:center;cursor:pointer;border:none;background:linear-gradient(135deg,rgba(48,209,88,0.2),rgba(48,209,88,0.05))" onclick="showScreen('quiz')">
            <div style="font-size:36px;margin-bottom:8px">🧠</div>
            <div style="font-size:15px;font-weight:700">اختبار</div>
            <div style="font-size:12px;color:var(--text2);margin-top:2px">اختبر نفسك</div>
          </button>
          <button class="card" style="padding:20px;text-align:center;cursor:pointer;border:none;background:linear-gradient(135deg,rgba(90,200,250,0.2),rgba(90,200,250,0.05))" onclick="showScreen('listening')">
            <div style="font-size:36px;margin-bottom:8px">🎧</div>
            <div style="font-size:15px;font-weight:700">استماع</div>
            <div style="font-size:12px;color:var(--text2);margin-top:2px">تدريب النطق</div>
          </button>
          <button class="card" style="padding:20px;text-align:center;cursor:pointer;border:none;background:linear-gradient(135deg,rgba(255,159,10,0.2),rgba(255,159,10,0.05))" onclick="showScreen('speaking')">
            <div style="font-size:36px;margin-bottom:8px">🎤</div>
            <div style="font-size:15px;font-weight:700">تحدّث</div>
            <div style="font-size:12px;color:var(--text2);margin-top:2px">مارس النطق</div>
          </button>
        </div>
      </div>

      <!-- RECENTLY LEARNED -->
      <div class="section">
        <div class="section-header">
          <div class="section-title">آخر ما تعلمته</div>
          <button class="section-link" onclick="showScreen('vocabulary')">المزيد</button>
        </div>
        <div style="display:flex;flex-direction:column;gap:8px" id="recent-words-list">
          <div style="text-align:center;color:var(--text3);padding:20px;font-size:15px">ابدأ التعلم لترى كلماتك هنا ✨</div>
        </div>
      </div>

      <!-- CONTINUE LESSON -->
      <div class="section">
        <div class="section-header"><div class="section-title">تابع التعلم</div></div>
        <div class="lesson-card" onclick="showScreen('lessons')">
          <div class="lesson-num gradient-accent" style="color:#fff">A1</div>
          <div class="lesson-info">
            <div class="lesson-title">الدرس الأول — التحيات</div>
            <div class="lesson-sub">تعلّم كيف تحيي وتودّع بالألمانية</div>
            <div style="margin-top:10px">
              <div class="progress-bar"><div class="progress-fill" id="lesson-progress" style="width:0%"></div></div>
            </div>
          </div>
          <div style="color:var(--text3);font-size:20px">›</div>
        </div>
      </div>

    </div>
  </div>

  <!-- VOCABULARY SCREEN -->
  <div class="screen" id="screen-vocabulary">
    <div class="status-bar"></div>
    <div class="header">
      <div style="width:44px"></div>
      <div class="header-title">المفردات</div>
      <button class="btn-icon" onclick="showScreen('search')">🔍</button>
    </div>
    <div style="padding:12px 16px">
      <div class="scroll-x" id="cat-scroll">
        <!-- categories rendered by JS -->
      </div>
    </div>
    <div class="scroll-area" id="vocab-list" style="padding-bottom:calc(var(--nav-height) + var(--safe-bottom) + 20px);padding-top:8px">
      <!-- rendered by JS -->
    </div>
  </div>

  <!-- FLASHCARDS SCREEN -->
  <div class="screen" id="screen-flashcards">
    <div class="status-bar"></div>
    <div class="header">
      <button class="header-btn" onclick="showScreen('home')">‹</button>
      <div class="header-title">البطاقات</div>
      <div style="width:44px;text-align:center;font-size:13px;color:var(--text2)" id="fc-counter">0/0</div>
    </div>
    <div style="flex:1;display:flex;flex-direction:column;align-items:center;padding:24px 16px;gap:20px;overflow:hidden">
      <!-- Progress -->
      <div style="width:100%">
        <div class="progress-bar"><div class="progress-fill" id="fc-progress" style="width:0%"></div></div>
      </div>
      <!-- Card -->
      <div style="flex:1;display:flex;align-items:center;justify-content:center;width:100%;perspective:1000px">
        <div class="flashcard" id="flashcard" onclick="flipCard()">
          <div class="fc-front">
            <div id="fc-cat-emoji" style="font-size:48px;margin-bottom:16px"></div>
            <div class="fc-de" id="fc-word-de"></div>
            <div id="fc-word-rom" style="font-size:16px;color:var(--text3);margin-top:8px;font-style:italic;direction:ltr"></div>
            <div class="fc-hint">اضغط للإجابة</div>
          </div>
          <div class="fc-back">
            <div id="fc-word-ar-back" class="fc-ar"></div>
            <div id="fc-example-back" class="fc-example"></div>
            <button class="btn-icon" style="position:absolute;top:16px;left:16px;background:var(--accent3)" onclick="speakWord(event)">🔊</button>
          </div>
        </div>
      </div>
      <!-- Actions -->
      <div id="fc-actions" style="display:none;width:100%;display:flex;gap:10px">
        <button class="btn btn-danger" style="flex:1;font-size:15px" onclick="rateCard('hard')">😓 صعب</button>
        <button class="btn btn-secondary" style="flex:1;font-size:15px;background:var(--yellow2);color:var(--yellow);border-color:var(--yellow)" onclick="rateCard('medium')">🤔 متوسط</button>
        <button class="btn btn-success" style="flex:1;font-size:15px" onclick="rateCard('easy')">😊 سهل</button>
      </div>
      <!-- Swipe hint when not flipped -->
      <div id="fc-swipe-hint" style="color:var(--text3);font-size:13px;text-align:center">اضغط على البطاقة لرؤية الإجابة</div>
    </div>
  </div>

  <!-- LESSONS SCREEN -->
  <div class="screen" id="screen-lessons">
    <div class="status-bar"></div>
    <div class="header">
      <div style="width:44px"></div>
      <div class="header-title">الدروس</div>
      <div style="width:44px"></div>
    </div>
    <div class="scroll-area">
      <!-- LEVEL A1 -->
      <div class="section" style="margin-top:16px">
        <div style="display:flex;align-items:center;gap:12px;margin-bottom:16px">
          <div style="padding:6px 16px;border-radius:100px;background:linear-gradient(135deg,#6c63ff,#a78bfa);color:#fff;font-size:13px;font-weight:800">A1 مبتدئ</div>
          <div style="font-size:13px;color:var(--text2)">الأساسيات</div>
        </div>
        <div style="display:flex;flex-direction:column;gap:10px" id="a1-lessons">
          <!-- rendered by JS -->
        </div>
      </div>
      <div class="section">
        <div style="display:flex;align-items:center;gap:12px;margin-bottom:16px">
          <div style="padding:6px 16px;border-radius:100px;background:linear-gradient(135deg,#0a84ff,#5ac8fa);color:#fff;font-size:13px;font-weight:800">A2 مبتدئ+</div>
          <div style="font-size:13px;color:var(--text2)">توسيع المعرفة</div>
        </div>
        <div style="display:flex;flex-direction:column;gap:10px" id="a2-lessons"></div>
      </div>
      <div class="section">
        <div style="display:flex;align-items:center;gap:12px;margin-bottom:16px">
          <div style="padding:6px 16px;border-radius:100px;background:linear-gradient(135deg,#30d158,#28b84a);color:#fff;font-size:13px;font-weight:800">B1 متوسط</div>
          <div style="font-size:13px;color:var(--text2)">قريباً...</div>
        </div>
        <div class="card" style="padding:24px;text-align:center;opacity:0.5">
          <div style="font-size:36px;margin-bottom:8px">🔒</div>
          <div style="font-size:15px;font-weight:600">أكمل مستوى A2 أولاً</div>
        </div>
      </div>
    </div>
  </div>

  <!-- QUIZ SCREEN -->
  <div class="screen" id="screen-quiz">
    <div class="status-bar"></div>
    <div class="header">
      <button class="header-btn" onclick="exitQuiz()">✕</button>
      <div class="header-title" id="quiz-title">اختبار</div>
      <div style="width:44px;font-size:13px;color:var(--text2);text-align:center" id="quiz-counter">1/10</div>
    </div>
    <div style="padding:0 16px 8px">
      <div class="progress-bar"><div class="progress-fill" id="quiz-progress" style="width:10%"></div></div>
    </div>
    <div style="flex:1;overflow-y:auto;padding:16px;padding-bottom:100px" id="quiz-area">
      <!-- rendered by JS -->
    </div>
    <!-- Result screen -->
    <div id="quiz-result" style="display:none;position:absolute;inset:0;background:var(--bg);display:flex;flex-direction:column;align-items:center;justify-content:center;padding:32px 24px;gap:20px;text-align:center">
      <div id="result-emoji" style="font-size:80px" class="bounce-in">🎉</div>
      <div style="font-size:32px;font-weight:800;letter-spacing:-1px" id="result-title">رائع!</div>
      <div style="font-size:17px;color:var(--text2)" id="result-sub">أكملت الاختبار</div>
      <div style="display:flex;gap:16px">
        <div class="stat-card" style="min-width:100px;align-items:center">
          <div class="stat-value" id="result-score" style="color:var(--green)">0</div>
          <div class="stat-label">صواب</div>
        </div>
        <div class="stat-card" style="min-width:100px;align-items:center">
          <div class="stat-value" id="result-wrong" style="color:var(--red)">0</div>
          <div class="stat-label">خطأ</div>
        </div>
        <div class="stat-card" style="min-width:100px;align-items:center">
          <div class="stat-value" id="result-xp" style="color:var(--yellow)">0</div>
          <div class="stat-label">XP</div>
        </div>
      </div>
      <button class="btn btn-primary" style="width:100%;margin-top:8px" onclick="startQuiz()">اختبار جديد</button>
      <button class="btn btn-secondary" style="width:100%" onclick="exitQuiz()">العودة</button>
    </div>
  </div>

  <!-- LISTENING SCREEN -->
  <div class="screen" id="screen-listening">
    <div class="status-bar"></div>
    <div class="header">
      <button class="header-btn" onclick="showScreen('home')">‹</button>
      <div class="header-title">تدريب الاستماع</div>
      <div style="width:44px"></div>
    </div>
    <div class="scroll-area" style="padding:16px">
      <div class="section-title" style="margin-bottom:16px;padding:0">استمع وتعلّم النطق الصحيح</div>
      <div id="listening-list" style="display:flex;flex-direction:column;gap:14px">
        <!-- rendered by JS -->
      </div>
    </div>
  </div>

  <!-- SPEAKING SCREEN -->
  <div class="screen" id="screen-speaking">
    <div class="status-bar"></div>
    <div class="header">
      <button class="header-btn" onclick="showScreen('home')">‹</button>
      <div class="header-title">تدريب النطق</div>
      <button class="header-btn" onclick="nextSpeakPhrase()">›</button>
    </div>
    <div style="flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:24px;gap:24px;text-align:center">
      <div style="font-size:14px;color:var(--text2);font-weight:600;letter-spacing:0.5px;text-transform:uppercase">قل بالألمانية</div>
      <div id="speak-phrase-de" style="font-size:28px;font-weight:800;letter-spacing:-0.5px;direction:ltr;line-height:1.3"></div>
      <div id="speak-phrase-ar" style="font-size:18px;color:var(--text2)"></div>
      <div class="player-card" style="width:100%">
        <div style="font-size:13px;color:var(--text2)">استمع أولاً:</div>
        <button class="btn btn-primary" style="width:100%" onclick="listenAndSpeak()">🔊 استمع للنطق</button>
      </div>
      <div class="speak-circle" id="speak-circle" onclick="toggleRecording()">
        <div class="speak-icon" id="speak-icon">🎤</div>
      </div>
      <div id="speak-status" style="font-size:15px;color:var(--text2)">اضغط للتحدث</div>
      <div id="speak-result" style="display:none;width:100%">
        <div class="card" style="padding:20px;text-align:center">
          <div id="speak-score" style="font-size:48px;font-weight:800"></div>
          <div id="speak-feedback" style="font-size:16px;color:var(--text2);margin-top:8px"></div>
        </div>
        <button class="btn btn-secondary" style="width:100%;margin-top:12px" onclick="nextSpeakPhrase()">التالية ›</button>
      </div>
    </div>
  </div>

  <!-- SEARCH SCREEN -->
  <div class="screen" id="screen-search">
    <div class="status-bar"></div>
    <div class="header">
      <button class="header-btn" onclick="goBack()">‹</button>
      <div class="header-title">بحث</div>
      <div style="width:44px"></div>
    </div>
    <div style="padding:12px 16px">
      <div class="search-bar">
        <span style="font-size:18px;color:var(--text3)">🔍</span>
        <input id="search-input" placeholder="ابحث بالعربية أو الألمانية..." oninput="doSearch(this.value)" autocomplete="off" autocorrect="off" spellcheck="false">
      </div>
    </div>
    <div class="scroll-area" style="padding:8px 0;padding-bottom:100px" id="search-results">
      <div style="text-align:center;color:var(--text3);padding:40px 20px">
        <div style="font-size:40px;margin-bottom:12px">🔍</div>
        <div>ابحث عن كلمة ألمانية أو عربية</div>
      </div>
    </div>
  </div>

  <!-- PROFILE/STATS SCREEN -->
  <div class="screen" id="screen-profile">
    <div class="status-bar"></div>
    <div class="header">
      <button class="header-btn" onclick="showScreen('home')">‹</button>
      <div class="header-title">ملفي</div>
      <button class="header-btn" onclick="showScreen('settings')">⚙️</button>
    </div>
    <div class="scroll-area">
      <div class="profile-hero">
        <div class="avatar">🧑‍🎓</div>
        <div class="profile-name" id="profile-name">المتعلم</div>
        <div class="profile-sub">متعلم الألمانية — المستوى <span id="profile-level">1</span></div>
        <div style="display:flex;gap:12px;margin-top:8px">
          <div class="streak-display">🔥 <span id="profile-streak">0</span> يوم</div>
          <div class="badge" style="background:var(--yellow2);color:var(--yellow)">⭐ <span id="profile-xp">0</span> XP</div>
        </div>
      </div>

      <!-- LEVEL PROGRESS -->
      <div class="section">
        <div class="section-title" style="margin-bottom:12px">تقدم المستوى</div>
        <div class="card" style="padding:20px">
          <div style="display:flex;align-items:center;gap:16px;margin-bottom:14px">
            <div class="level-ring" style="--pct:0%" id="level-ring">
              <div class="level-ring-text" id="level-ring-text">1</div>
            </div>
            <div>
              <div style="font-size:18px;font-weight:700">المستوى <span id="level-label">1</span></div>
              <div style="font-size:13px;color:var(--text2);margin-top:2px"><span id="xp-to-next">100</span> XP للمستوى التالي</div>
            </div>
          </div>
          <div class="progress-bar" style="height:10px"><div class="progress-fill" id="level-progress-fill" style="width:0%"></div></div>
        </div>
      </div>

      <!-- STATS GRID -->
      <div class="section">
        <div class="section-title" style="margin-bottom:12px">إحصائياتي</div>
        <div class="stat-grid">
          <div class="stat-card">
            <div class="stat-value" id="stat-words" style="color:var(--accent2)">0</div>
            <div class="stat-label">كلمة تعلمتها</div>
          </div>
          <div class="stat-card">
            <div class="stat-value" id="stat-quizzes" style="color:var(--green)">0</div>
            <div class="stat-label">اختبار أكملته</div>
          </div>
          <div class="stat-card">
            <div class="stat-value" id="stat-accuracy" style="color:var(--yellow)">0%</div>
            <div class="stat-label">دقة الإجابات</div>
          </div>
          <div class="stat-card">
            <div class="stat-value" id="stat-lessons" style="color:var(--orange)">0</div>
            <div class="stat-label">درس أكملته</div>
          </div>
          <div class="stat-card">
            <div class="stat-value" id="stat-mastered" style="color:var(--teal)">0</div>
            <div class="stat-label">كلمات متقنة</div>
          </div>
          <div class="stat-card">
            <div class="stat-value" id="stat-learning" style="color:var(--pink)">0</div>
            <div class="stat-label">قيد التعلم</div>
          </div>
          <div class="stat-card">
            <div class="stat-value" id="stat-pronunciation" style="color:var(--accent2)">0%</div>
            <div class="stat-label">متوسط النطق</div>
          </div>
          <div class="stat-card">
            <div class="stat-value" id="stat-ef" style="color:var(--green)">2.5</div>
            <div class="stat-label">عامل السهولة</div>
          </div>
        </div>
      </div>

      <!-- ACHIEVEMENTS -->
      <div class="section">
        <div class="section-title" style="margin-bottom:12px">الإنجازات</div>
        <div style="display:flex;flex-direction:column;gap:10px" id="achievements-list">
          <!-- rendered by JS -->
        </div>
      </div>

      <!-- FAVORITES -->
      <div class="section">
        <div class="section-header">
          <div class="section-title">المفضلة</div>
          <div style="font-size:13px;color:var(--text2)" id="fav-count">0 كلمة</div>
        </div>
        <div style="display:flex;flex-direction:column;gap:8px" id="favorites-list">
          <div style="text-align:center;color:var(--text3);padding:16px;font-size:14px">لا توجد كلمات مفضلة بعد<br>اضغط ❤️ على أي كلمة لحفظها</div>
        </div>
      </div>
    </div>
  </div>

  <!-- SETTINGS SCREEN -->
  <div class="screen" id="screen-settings">
    <div class="status-bar"></div>
    <div class="header">
      <button class="header-btn" onclick="showScreen('profile')">‹</button>
      <div class="header-title">الإعدادات</div>
      <div style="width:44px"></div>
    </div>
    <div class="scroll-area" style="padding-top:12px;padding-bottom:100px">
      <div class="section-title" style="padding:0 16px;margin-bottom:8px;font-size:13px;color:var(--text2);text-transform:uppercase;letter-spacing:0.5px">التعلم</div>
      <div class="card" style="margin:0 16px 20px;overflow:hidden">
        <div class="settings-row" onclick="toggleNotif()">
          <div class="settings-icon" style="background:rgba(255,159,10,0.15)">🔔</div>
          <div class="settings-label">تذكير يومي</div>
          <button class="toggle" id="toggle-notif"></button>
        </div>
        <div class="divider"></div>
        <div class="settings-row">
          <div class="settings-icon" style="background:var(--accent3)">🎯</div>
          <div class="settings-label">هدف يومي</div>
          <div class="settings-value">10 كلمات</div>
        </div>
        <div class="divider"></div>
        <div class="settings-row">
          <div class="settings-icon" style="background:var(--green2)">⚡</div>
          <div class="settings-label">سرعة النطق</div>
          <div style="display:flex;gap:6px">
            <button class="speed-btn active" id="speed-slow" onclick="setSpeed(0.7,this)">بطيء</button>
            <button class="speed-btn" id="speed-normal" onclick="setSpeed(1,this)">عادي</button>
            <button class="speed-btn" id="speed-fast" onclick="setSpeed(1.3,this)">سريع</button>
          </div>
        </div>
      </div>

      <div class="section-title" style="padding:0 16px;margin-bottom:8px;font-size:13px;color:var(--text2);text-transform:uppercase;letter-spacing:0.5px">الحساب</div>
      <div class="card" style="margin:0 16px 20px;overflow:hidden">
        <div class="settings-row" onclick="editName()">
          <div class="settings-icon" style="background:rgba(90,200,250,0.15)">👤</div>
          <div class="settings-label">الاسم</div>
          <div class="settings-value" id="settings-name">المتعلم</div>
        </div>
        <div class="divider"></div>
        <div class="settings-row" onclick="resetProgress()">
          <div class="settings-icon" style="background:var(--red2)">🔄</div>
          <div class="settings-label" style="color:var(--red)">إعادة ضبط التقدم</div>
        </div>
      </div>

      <div class="section-title" style="padding:0 16px;margin-bottom:8px;font-size:13px;color:var(--text2);text-transform:uppercase;letter-spacing:0.5px">التطبيق</div>
      <div class="card" style="margin:0 16px 20px;overflow:hidden">
        <div class="settings-row">
          <div class="settings-icon" style="background:var(--yellow2)">ℹ️</div>
          <div class="settings-label">الإصدار</div>
          <div class="settings-value">2.0.0</div>
        </div>
        <div class="divider"></div>
        <div class="settings-row">
          <div class="settings-icon" style="background:var(--accent3)">🇩🇪</div>
          <div class="settings-label">لغة التطبيق</div>
          <div class="settings-value">العربية</div>
        </div>
      </div>
    </div>
  </div>

  <!-- LESSON DETAIL SCREEN -->
  <div class="screen" id="screen-lesson-detail">
    <div class="status-bar"></div>
    <div class="header">
      <button class="header-btn" onclick="showScreen('lessons')">‹</button>
      <div class="header-title" id="ld-title">الدرس</div>
      <div style="width:44px"></div>
