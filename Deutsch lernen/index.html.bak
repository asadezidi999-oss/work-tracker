      <div class="nav-icon" aria-hidden="true">📖</div>
      <div class="nav-label">مفردات</div>
    </button>
    <button class="nav-item" data-screen="lessons" onclick="navTo('lessons')" role="tab" aria-selected="false" aria-label="الدروس">
      <div class="nav-icon" aria-hidden="true">📚</div>
      <div class="nav-label">دروس</div>
    </button>
    <button class="nav-item" data-screen="quiz" onclick="navTo('quiz')" role="tab" aria-selected="false" aria-label="الاختبارات">
      <div class="nav-icon" aria-hidden="true">🧠</div>
      <div class="nav-label">اختبار</div>
    </button>
    <button class="nav-item" data-screen="profile" onclick="navTo('profile')" role="tab" aria-selected="false" aria-label="ملفي">
      <div class="nav-icon" aria-hidden="true">👤</div>
      <div class="nav-label">ملفي</div>
    </button>
  </nav>
</div>

<!-- WORD DETAIL MODAL -->
<div class="modal-overlay" id="word-modal" onclick="closeWordModal(event)" role="dialog" aria-modal="true" aria-label="تفاصيل الكلمة">
  <div class="modal-sheet" role="document">
    <div class="modal-handle" aria-hidden="true"></div>
    <div style="text-align:center;margin-bottom:20px">
      <div id="modal-emoji" style="font-size:56px;margin-bottom:12px"></div>
      <div class="word-detail-de" id="modal-de"></div>
      <div id="modal-rom" style="font-size:15px;color:var(--text3);font-style:italic;direction:ltr;margin-top:4px"></div>
      <div class="word-detail-ar" id="modal-ar"></div>
    </div>
    <div style="display:flex;gap:10px;margin-bottom:20px">
      <button class="btn btn-secondary" style="flex:1" onclick="speakModalWord()">🔊 استمع</button>
      <button class="btn btn-secondary" style="flex:1" id="modal-fav-btn" onclick="toggleFavorite()">❤️ مفضلة</button>
    </div>
    <div class="card2" style="padding:16px;margin-bottom:16px">
      <div style="font-size:12px;color:var(--text2);margin-bottom:8px;font-weight:600;text-transform:uppercase;letter-spacing:0.5px">مثال</div>
      <div id="modal-example-de" style="font-size:16px;font-weight:600;direction:ltr;margin-bottom:6px;line-height:1.5"></div>
      <div id="modal-example-ar" style="font-size:14px;color:var(--text2)"></div>
    </div>
    <div style="display:flex;gap:10px">
      <div style="flex:1">
        <div style="font-size:12px;color:var(--text2);margin-bottom:4px">الفئة</div>
        <div id="modal-cat" style="font-size:14px;font-weight:600"></div>
      </div>
      <div style="flex:1">
        <div style="font-size:12px;color:var(--text2);margin-bottom:4px">الصعوبة</div>
        <div id="modal-diff"></div>
      </div>
    </div>
  </div>
</div>

<script>
// ═══════════════════════════════════════════════════
// DATA
// ═══════════════════════════════════════════════════
const CATEGORIES = [
  {id:'all', name:'الكل', emoji:'🌐'},
  {id:'daily', name:'الحياة اليومية', emoji:'☀️'},
  {id:'food', name:'الطعام', emoji:'🍔'},
  {id:'shopping', name:'التسوق', emoji:'🛍️'},
  {id:'work', name:'العمل', emoji:'💼'},
  {id:'travel', name:'السفر', emoji:'✈️'},
  {id:'family', name:'العائلة', emoji:'👨‍👩‍👧'},
  {id:'health', name:'الصحة', emoji:'💊'},
  {id:'tech', name:'التقنية', emoji:'📱'},
];

const VOCAB = [
  // Daily Life
  {id:1,de:'Hallo',rom:'Halo',ar:'مرحبا',cat:'daily',diff:'easy',emoji:'👋',ex_de:'Hallo, wie geht es Ihnen?',ex_ar:'مرحبا، كيف حالك؟'},
  {id:2,de:'Guten Morgen',rom:'Gooten Morgen',ar:'صباح الخير',cat:'daily',diff:'easy',emoji:'🌅',ex_de:'Guten Morgen! Wie war dein Schlaf?',ex_ar:'صباح الخير! كيف كان نومك؟'},
  {id:3,de:'Guten Abend',rom:'Gooten Abend',ar:'مساء الخير',cat:'daily',diff:'easy',emoji:'🌙',ex_de:'Guten Abend, alle zusammen!',ex_ar:'مساء الخير للجميع!'},
  {id:4,de:'Auf Wiedersehen',rom:'Auf Veederzehen',ar:'مع السلامة',cat:'daily',diff:'medium',emoji:'👋',ex_de:'Auf Wiedersehen, bis morgen!',ex_ar:'مع السلامة، إلى الغد!'},
  {id:5,de:'Danke',rom:'Danke',ar:'شكراً',cat:'daily',diff:'easy',emoji:'🙏',ex_de:'Danke sehr für Ihre Hilfe!',ex_ar:'شكراً جزيلاً على مساعدتك!'},
  {id:6,de:'Bitte',rom:'Bitte',ar:'من فضلك / عفواً',cat:'daily',diff:'easy',emoji:'😊',ex_de:'Bitte, kommen Sie herein.',ex_ar:'تفضل، ادخل.'},
  {id:7,de:'Entschuldigung',rom:'Entshuldigung',ar:'عذراً / آسف',cat:'daily',diff:'medium',emoji:'😔',ex_de:'Entschuldigung, wo ist der Bahnhof?',ex_ar:'عذراً، أين المحطة؟'},
  {id:8,de:'Ja',rom:'Ya',ar:'نعم',cat:'daily',diff:'easy',emoji:'✅',ex_de:'Ja, das ist richtig.',ex_ar:'نعم، هذا صحيح.'},
  {id:9,de:'Nein',rom:'Nine',ar:'لا',cat:'daily',diff:'easy',emoji:'❌',ex_de:'Nein, ich verstehe das nicht.',ex_ar:'لا، لا أفهم هذا.'},
  {id:10,de:'Wie heißen Sie?',rom:'Vee haissen zee?',ar:'ما اسمك؟',cat:'daily',diff:'medium',emoji:'🗣️',ex_de:'Wie heißen Sie? Ich heiße Ahmad.',ex_ar:'ما اسمك؟ اسمي أحمد.'},
  {id:11,de:'Wie geht es Ihnen?',rom:'Vee gayt es eenen?',ar:'كيف حالك؟',cat:'daily',diff:'medium',emoji:'💬',ex_de:'Wie geht es Ihnen heute?',ex_ar:'كيف حالك اليوم؟'},
  {id:12,de:'Mir geht es gut',rom:'Meer gayt es goot',ar:'أنا بخير',cat:'daily',diff:'medium',emoji:'😊',ex_de:'Danke, mir geht es gut!',ex_ar:'شكراً، أنا بخير!'},
  {id:13,de:'Das Haus',rom:'Das Haus',ar:'البيت',cat:'daily',diff:'easy',emoji:'🏠',ex_de:'Das Haus ist sehr groß.',ex_ar:'البيت كبير جداً.'},
  {id:14,de:'Die Stadt',rom:'Dee Shtat',ar:'المدينة',cat:'daily',diff:'easy',emoji:'🏙️',ex_de:'Berlin ist eine schöne Stadt.',ex_ar:'برلين مدينة جميلة.'},
  {id:15,de:'Das Wasser',rom:'Das Vasser',ar:'الماء',cat:'daily',diff:'easy',emoji:'💧',ex_de:'Ich trinke jeden Tag viel Wasser.',ex_ar:'أشرب الكثير من الماء يومياً.'},
  // Food
  {id:16,de:'Das Brot',rom:'Das Brot',ar:'الخبز',cat:'food',diff:'easy',emoji:'🍞',ex_de:'Ich möchte frisches Brot kaufen.',ex_ar:'أريد شراء خبز طازج.'},
